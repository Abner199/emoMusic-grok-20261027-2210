[{"t0": 0.0, "t1": 1.8, "text": "我仍然從小學少 族人舞蹈"}, {"t0": 1.8, "t1": 3.1, "text": "怎麼該怎麼該"}, {"t0": 3.1, "t1": 4.1, "text": "呼吸吐納性自在"}, {"t0": 4.1, "t1": 5.5, "text": "怎麼該怎麼该"}, {"t0": 5.5, "t1": 6.5, "text": "其真難免受性害"}, {"t0": 6.5, "t1": 7.9, "text": "怎麼該怎么該"}, {"t0": 7.9, "t1": 9.0, "text": "日行前平息下賴"}, {"t0": 9.0, "t1": 11.3, "text": "非夜周避 莫其怪 曲音曲音就來"}, {"t0": 11.3, "t1": 13.2, "text": "欸 幹嘛不向前 一起一著"}, {"t0": 13.2, "t1": 14.9, "text": "更無權應用 擴權一句惹貓"}, {"t0": 14.9, "t1": 16.3, "text": "我的人有危險"}, {"t0": 16.3, "t1": 18.1, "text": "一再重演 一根我不抽的煙"}, {"t0": 18.1, "t1": 20.8, "text": "一放好多年 他一直在身邊跑"}, {"t0": 20.8, "t1": 22.1, "text": "怎麼該怎麼開"}, {"t0": 22.1, "t1": 23.3, "text": "我打開任督二脈"}, {"t0": 23.3, "t1": 24.5, "text": "怎麼該怎麼來"}, {"t0": 24.5, "t1": 25.6, "text": "東洋兵分的詐敗"}, {"t0": 25.6, "t1": 26.9, "text": "怎麼該怎麼蓋"}, {"t0": 26.9, "t1": 28.5, "text": "一被我一甲踢一開"}, {"t0": 28.5, "t1": 29.3, "text": "哈"}, {"t0": 29.3, "t1": 29.98, "text": "小明星大跟班下次再見"}]