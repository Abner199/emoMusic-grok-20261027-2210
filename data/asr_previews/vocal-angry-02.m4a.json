[{"t0": 0.0, "t1": 2.0, "text": "激動感動 賽車一聲鼓鼓吼"}, {"t0": 12.0, "t1": 14.0, "text": "要克服這些幻想"}, {"t0": 15.0, "t1": 17.0, "text": "無限的牽掛理性"}, {"t0": 17.0, "t1": 20.0, "text": "我把一台風將被將水泡空"}, {"t0": 20.0, "t1": 22.0, "text": "連在鼓樓喝到冰冰凍"}, {"t0": 23.0, "t1": 25.0, "text": "我丟下彈牌來點花香溫柔"}, {"t0": 25.0, "t1": 28.0, "text": "爬上一層樓梯以後每天變得瘋"}, {"t0": 28.0, "t1": 30.0, "text": "江湖东方的那种挑战的时光"}]