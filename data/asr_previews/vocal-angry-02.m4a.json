[{"t0": 0.0, "t1": 2.0, "text": "嘻嘻跟嘻 賽車一生不通"}, {"t0": 12.0, "t1": 15.0, "text": "呀 可惡的心 幻想不理"}, {"t0": 15.0, "t1": 17.0, "text": "有些人將面臨行"}, {"t0": 17.0, "t1": 20.0, "text": "會把一台風 降臨 降雪暴風"}, {"t0": 20.0, "t1": 22.0, "text": "人家鼓掌 滑倒的遠遠"}, {"t0": 23.0, "t1": 25.0, "text": "我 多情太太來臉 往前溫柔"}, {"t0": 25.0, "t1": 28.0, "text": "把現在最幸運 混淆的冰冷風"}, {"t0": 28.0, "t1": 30.0, "text": "降落光芒 等得住 挑战的时刻"}]