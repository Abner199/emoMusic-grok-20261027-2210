[{"t0": 0.0, "t1": 3.0, "text": "你不为啥子走"}, {"t0": 3.0, "t1": 7.0, "text": "把手慢慢交给我"}, {"t0": 7.0, "t1": 11.0, "text": "放下心中的困惑"}, {"t0": 11.0, "t1": 15.0, "text": "雨点总两方划过"}, {"t0": 15.0, "t1": 19.0, "text": "隔开两种精神的我"}, {"t0": 19.0, "t1": 22.0, "text": "经过老婆的家"}, {"t0": 22.0, "t1": 25.0, "text": "安库变得好高"}, {"t0": 25.0, "t1": 27.0, "text": "爬过的那个树"}, {"t0": 27.0, "t1": 30.0, "text": "又何時變得渺小"}]