[{"t0": 0.0, "t1": 2.0, "text": "Zither Harp"}, {"t0": 3.0, "t1": 4.0, "text": "透過幾秒鐘聲"}, {"t0": 4.0, "t1": 7.0, "text": "解解理想個人的心傷"}, {"t0": 7.0, "t1": 10.0, "text": "把念念記錄變得悄悄的"}, {"t0": 10.0, "t1": 12.0, "text": "在距離成雙"}, {"t0": 12.0, "t1": 14.0, "text": "沈舍的離得遠方"}, {"t0": 14.0, "t1": 16.0, "text": "默默聽 全都快熄滅"}, {"t0": 16.0, "t1": 20.0, "text": "你還沒有溫暖的手掌"}, {"t0": 21.0, "t1": 23.0, "text": "啊啊啊啊"}, {"t0": 23.0, "t1": 25.0, "text": "放手了你"}, {"t0": 25.0, "t1": 28.0, "text": "啊啊啊"}, {"t0": 28.0, "t1": 30.0, "text": "我心中的汗水"}]