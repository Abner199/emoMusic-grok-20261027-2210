[{"t0": 0.0, "t1": 7.12, "text": "愛 不用可以安排"}, {"t0": 7.12, "t1": 10.88, "text": "憑感覺去親吻相擁"}, {"t0": 10.88, "t1": 13.12, "text": "就會很愉快"}, {"t0": 13.12, "t1": 15.76, "text": "享受現在"}, {"t0": 15.76, "t1": 21.64, "text": "別開會就怕受傷害"}, {"t0": 21.64, "t1": 25.72, "text": "許多奇蹟我們相信"}, {"t0": 25.72, "t1": 28.52, "text": "才會存在"}, {"t0": 28.52, "t1": 29.92, "text": "Zither Harp"}]