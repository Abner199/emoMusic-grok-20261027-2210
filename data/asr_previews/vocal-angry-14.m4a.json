[{"t0": 0.0, "t1": 4.6, "text": "我 請你這張光 上落的繁光"}, {"t0": 4.6, "t1": 6.8, "text": "這張聲間 心中的光芒"}, {"t0": 6.8, "t1": 9.6, "text": "打的穿著唱 不看得上"}, {"t0": 9.6, "t1": 12.6, "text": "腳本正在上 演出最後一場歌"}, {"t0": 12.6, "t1": 15.4, "text": "群聚的人們在座位上 寂靜的看"}, {"t0": 15.4, "t1": 17.6, "text": "時間如何 一起這劇場"}, {"t0": 17.6, "t1": 19.6, "text": "這溫柔張 燈的淚光 色彈波衝"}, {"t0": 19.6, "t1": 21.4, "text": "唱歌這趟 最過是一開始的星空"}, {"t0": 21.4, "t1": 22.8, "text": "環扇間 一起這批亮光"}, {"t0": 22.8, "t1": 25.3, "text": "量空懼的 在孩子們臉上"}, {"t0": 25.3, "t1": 28.0, "text": "滿天一刀香 沾著經過的方向"}, {"t0": 28.0, "t1": 29.8, "text": "不過為了形狀 整個山"}, {"t0": 29.8, "t1": 30.3, "text": "by bwd6"}]