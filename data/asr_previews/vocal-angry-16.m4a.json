[{"t0": 0.0, "t1": 4.5, "text": "把三分球 踏在空中的流"}, {"t0": 4.5, "t1": 8.0, "text": "所有人看著我 跑無限盡舊"}, {"t0": 8.0, "t1": 12.0, "text": "單手過人運球 按下秒傳出舊"}, {"t0": 12.0, "t1": 15.5, "text": "漂亮的假動作 甩掉了我"}, {"t0": 15.5, "t1": 19.5, "text": "全場停了防守 攔下進去遊走"}, {"t0": 19.5, "t1": 23.0, "text": "快攻進藍單球 得分都靠我"}, {"t0": 23.0, "t1": 26.5, "text": "用他的球骨頭 又不可厭惡"}, {"t0": 26.5, "t1": 29.9, "text": "尋覓著終的悠 踏到了"}]