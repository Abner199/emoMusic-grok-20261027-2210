[{"t0": 0.0, "t1": 18.0, "text": "Zither Harp"}, {"t0": 18.0, "t1": 21.0, "text": "放手一波的下一個常規"}, {"t0": 21.0, "t1": 23.0, "text": "迎著佛技術再超越"}, {"t0": 23.0, "t1": 25.0, "text": "那手能指使在一槍飛"}, {"t0": 25.0, "t1": 27.0, "text": "他們卻沒得破五疊"}, {"t0": 27.0, "t1": 29.0, "text": "不得什麼就有花生的季節"}, {"t0": 29.0, "t1": 30.0, "text": "想不想你吵"}]