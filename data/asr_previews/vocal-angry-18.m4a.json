[{"t0": 0.0, "t1": 18.0, "text": "Zither Harp"}, {"t0": 19.0, "t1": 21.0, "text": "放手一搏 連誰都慚愧"}, {"t0": 21.0, "t1": 23.0, "text": "迎接風氣 說再超越"}, {"t0": 23.0, "t1": 25.0, "text": "把手們只剩粉液搶飛"}, {"t0": 25.0, "t1": 27.0, "text": "它們卻沒有火蝴蝶"}, {"t0": 27.0, "t1": 29.0, "text": "不管什麼 就有花香的季節"}, {"t0": 29.0, "t1": 30.0, "text": "誰都叫你操"}]