[{"t0": 0.0, "t1": 2.0, "text": "叮叮叠叮叨叨崩崩"}, {"t0": 2.0, "t1": 5.0, "text": "水谷江原来这有时光景这么夸张"}, {"t0": 5.0, "t1": 7.0, "text": "专属四通过营有小张"}, {"t0": 7.0, "t1": 9.0, "text": "花营有趣我怎么办老师"}, {"t0": 9.0, "t1": 11.0, "text": "说有点急着啊啊"}, {"t0": 11.0, "t1": 14.0, "text": "江湘我正在等待妈妈"}, {"t0": 14.0, "t1": 17.0, "text": "不住远方向前方"}, {"t0": 17.0, "t1": 20.0, "text": "散步着村中长汉"}, {"t0": 20.0, "t1": 21.0, "text": "在面望光的"}, {"t0": 21.0, "t1": 23.0, "text": "我这天天看飞动"}, {"t0": 23.0, "t1": 24.0, "text": "进行坠落地平前处"}, {"t0": 24.0, "t1": 25.0, "text": "人影中好奇"}, {"t0": 25.0, "t1": 27.0, "text": "我编练白头天天我飞"}, {"t0": 27.0, "t1": 29.0, "text": "谁也认为谁我是鬼"}, {"t0": 29.0, "t1": 30.0, "text": "哎呀 这边"}]