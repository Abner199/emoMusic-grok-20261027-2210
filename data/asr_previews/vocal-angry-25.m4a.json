[{"t0": 0.0, "t1": 5.0, "text": "新鮮的箭頭 都只想離散越貴的地方"}, {"t0": 5.0, "t1": 7.0, "text": "領會欠金 但這就還是得要習慣"}, {"t0": 7.0, "t1": 10.0, "text": "多想想的人惡 一流不是你最大的致命"}, {"t0": 10.0, "t1": 12.0, "text": "所以我按兵不動 注意習慣"}, {"t0": 12.0, "t1": 14.0, "text": "凡事沉默的平等當頭炮"}, {"t0": 14.0, "t1": 17.0, "text": "純粹注意我禮貌的開場 屏風馬兒"}, {"t0": 17.0, "t1": 19.0, "text": "雄黃的鏈子來一柔可剛"}, {"t0": 19.0, "t1": 21.0, "text": "第26招 寶劍子"}, {"t0": 21.0, "t1": 23.0, "text": "這時代時代 驚恨揚聲聲吵 絕而平靜"}, {"t0": 23.0, "t1": 25.0, "text": "在初小的空白街 暗箭難防"}, {"t0": 25.0, "t1": 28.0, "text": "這裡藏不留血的糖 自由自尊會受傷"}, {"t0": 28.0, "t1": 30.0, "text": "從網吧扣到電章 關鍵怎麼上"}]