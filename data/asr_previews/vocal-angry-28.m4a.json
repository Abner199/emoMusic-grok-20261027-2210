[{"t0": 0.0, "t1": 3.4, "text": "突然画面一笑就全暗"}, {"t0": 3.4, "t1": 6.6, "text": "还在想到底现在何方"}, {"t0": 6.6, "t1": 9.8, "text": "点模样是个怀疑功能"}, {"t0": 9.8, "t1": 13.0, "text": "开始想认真细心装扮"}, {"t0": 13.0, "t1": 15.8, "text": "回台上终于乱无上场"}, {"t0": 15.8, "t1": 18.6, "text": "说话讲一个红空翻"}, {"t0": 18.6, "t1": 22.2, "text": "要声援着转抹布杂荡弯道"}, {"t0": 22.2, "t1": 25.0, "text": "说话讲你谁都漂亮"}, {"t0": 25.0, "t1": 28.4, "text": "接着上一段与其合广"}, {"t0": 28.4, "t1": 30.0, "text": "我说 发折"}]