[{"t0": 0.0, "t1": 6.0, "text": "一片梦梦 能够有时晚时空"}, {"t0": 6.0, "t1": 15.0, "text": "我心一场沉默 只与此一切成功"}, {"t0": 15.0, "t1": 18.0, "text": "来夜重重 聚夜重重 很不能相逢"}, {"t0": 18.0, "t1": 22.0, "text": "爱也重重 能夜重重 一切都最后"}, {"t0": 22.0, "t1": 26.0, "text": "光笑一声 常看一声 快播一声 悲哀一声"}, {"t0": 26.0, "t1": 29.0, "text": "谁与我生死与共"}, {"t0": 29.0, "t1": 30.0, "text": "那一夜终究"}]