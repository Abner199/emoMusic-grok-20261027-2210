[{"t0": 0.0, "t1": 4.52, "text": "隐隐随便河送"}, {"t0": 4.52, "t1": 6.4, "text": "拉开了胸圈"}, {"t0": 6.4, "t1": 9.08, "text": "要准备等的时间"}, {"t0": 9.08, "t1": 12.08, "text": "走吧 走吧"}, {"t0": 12.08, "t1": 16.64, "text": "别打声反反"}, {"t0": 16.64, "t1": 18.48, "text": "在等我炫耀"}, {"t0": 18.48, "t1": 19.92, "text": "别难得自愁"}, {"t0": 19.92, "t1": 22.6, "text": "装成的困兽"}, {"t0": 22.6, "t1": 24.4, "text": "等却到背后"}, {"t0": 24.4, "t1": 25.92, "text": "纠黑的颜刀"}, {"t0": 25.92, "t1": 28.52, "text": "乱现的图谋"}, {"t0": 28.52, "t1": 30.52, "text": "I'm not leaving you"}]