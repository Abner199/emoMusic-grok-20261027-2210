[{"t0": 0.0, "t1": 7.0, "text": " Mercy come and wash away"}, {"t0": 7.0, "t1": 11.0, "text": " What I've done"}, {"t0": 11.0, "t1": 13.0, "text": " I'll face myself"}, {"t0": 13.0, "t1": 19.0, "text": " To cross out what I've become"}, {"t0": 19.0, "t1": 21.0, "text": " I'll erase myself"}, {"t0": 21.0, "t1": 26.0, "text": " And let go of what I've done"}, {"t0": 26.0, "t1": 29.0, "text": " But to ask what you've thought of me"}]