[{"t0": 0.0, "t1": 4.0, "text": "随时准备跟强者对决"}, {"t0": 4.0, "t1": 8.0, "text": "怕对我的执意和无限都会灭"}, {"t0": 8.0, "t1": 12.0, "text": "放纵的感觉 超越一切"}, {"t0": 12.0, "t1": 17.0, "text": "不再拦切 不需要你们的理解"}, {"t0": 17.0, "t1": 20.0, "text": "我不想看 别再废话"}, {"t0": 20.0, "t1": 24.0, "text": "趁早的消失在眼前"}, {"t0": 24.0, "t1": 28.0, "text": "我不再一流也废语"}, {"t0": 28.0, "t1": 30.0, "text": "也不是人般的方式"}]