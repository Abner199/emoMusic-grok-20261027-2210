[{"t0": 0.0, "t1": 3.0, "text": " Is this all the tiring time between and how"}, {"t0": 3.0, "t1": 5.0, "text": " Trying to put my trust in you"}, {"t0": 5.0, "t1": 7.0, "text": " Just take so much of me"}, {"t0": 7.0, "t1": 12.0, "text": " Take everything from the inside"}, {"t0": 12.0, "t1": 15.0, "text": " And throw it all away"}, {"t0": 15.0, "t1": 19.0, "text": " Cause I swear for the last time"}, {"t0": 19.0, "t1": 23.0, "text": " I won't trust myself with you"}, {"t0": 23.0, "t1": 27.0, "text": " Tension is building inside"}, {"t0": 27.0, "t1": 29.0, "text": " Steadily"}, {"t0": 29.0, "t1": 30.0, "text": " Feel so far"}]