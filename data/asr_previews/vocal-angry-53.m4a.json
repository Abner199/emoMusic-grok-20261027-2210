[{"t0": 0.0, "t1": 7.0, "text": "年月把擁有變做失去"}, {"t0": 7.0, "t1": 14.0, "text": "疲倦的雙眼大著期望"}, {"t0": 14.0, "t1": 18.0, "text": "今天只有殘留的退後"}, {"t0": 18.0, "t1": 21.0, "text": "迎接荒歸歲月"}, {"t0": 21.0, "t1": 26.0, "text": "風雨中抱緊自由"}, {"t0": 26.0, "t1": 29.0, "text": "一生經過旁旺的"}, {"t0": 29.0, "t1": 30.0, "text": "oh baby"}]