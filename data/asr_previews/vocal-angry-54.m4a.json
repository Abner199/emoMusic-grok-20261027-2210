[{"t0": 0.0, "t1": 1.84, "text": " They were back at my soul, they sailed"}, {"t0": 1.84, "t1": 3.84, "text": " Can't respect up the best, they fell"}, {"t0": 3.84, "t1": 5.84, "text": " Let the rest be the tale, they tell"}, {"t0": 5.84, "t1": 6.84, "text": " I was assed in"}, {"t0": 6.84, "t1": 10.34, "text": " And these promises broken"}, {"t0": 10.34, "t1": 12.34, "text": " Deep below"}, {"t0": 12.34, "t1": 16.0, "text": " Each word gets lost in the echo"}, {"t0": 16.0, "t1": 18.34, "text": " So one last lie"}, {"t0": 18.34, "t1": 20.34, "text": " I can see through"}, {"t0": 20.34, "t1": 24.84, "text": " This time I finally let you"}, {"t0": 24.84, "t1": 26.84, "text": " Go"}, {"t0": 26.84, "t1": 28.84, "text": " Go"}, {"t0": 28.84, "t1": 29.84, "text": " Go!"}]