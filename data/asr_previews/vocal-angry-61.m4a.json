[{"t0": 0.0, "t1": 3.0, "text": "我的默契都不愿"}, {"t0": 3.0, "t1": 6.0, "text": "完美的夜中周旋"}, {"t0": 6.0, "t1": 8.0, "text": "我跟他黑白的脸"}, {"t0": 8.0, "t1": 11.0, "text": "一张张脸色都在变迁"}, {"t0": 11.0, "t1": 14.0, "text": "人的心在摩擦画面"}, {"t0": 14.0, "t1": 17.0, "text": "就站在爱与恨之间"}, {"t0": 17.0, "t1": 19.0, "text": "天使玫瑰都在身边"}, {"t0": 19.0, "t1": 22.0, "text": "这每周变得变全"}, {"t0": 22.0, "t1": 25.0, "text": "我的默夜都不愉"}, {"t0": 25.0, "t1": 28.0, "text": "我只能祈求上天"}, {"t0": 28.0, "t1": 30.0, "text": "追我進彩樓"}]