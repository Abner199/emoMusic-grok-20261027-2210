[{"t0": 0.0, "t1": 5.0, "text": "人真只是我"}, {"t0": 5.0, "t1": 10.0, "text": "看太寒 离风霜"}, {"t0": 10.0, "t1": 14.0, "text": "我孤雄前进"}, {"t0": 14.0, "t1": 20.0, "text": "万古将 任我唱"}, {"t0": 20.0, "t1": 24.0, "text": "梦一样的自然"}, {"t0": 24.0, "t1": 28.0, "text": "悲也匆扰 歌也匆绕"}, {"t0": 28.0, "t1": 30.0, "text": "追深处理"}]