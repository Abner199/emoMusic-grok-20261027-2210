[{"t0": 0.0, "t1": 4.6, "text": "徘徊在幽谷的念头 宁静是奢侈的奢求"}, {"t0": 4.6, "t1": 7.8, "text": "轮延的视线的破口"}, {"t0": 7.8, "t1": 12.0, "text": "就直立破碎的葫芦"}, {"t0": 12.0, "t1": 16.4, "text": "哪里是主宗的声索"}, {"t0": 16.4, "t1": 20.0, "text": "我抽乱心中的寄托"}, {"t0": 20.0, "t1": 25.0, "text": "埋不入火 依然执着"}, {"t0": 25.0, "t1": 29.0, "text": "Just follow me"}, {"t0": 29.0, "t1": 30.0, "text": "感受"}]