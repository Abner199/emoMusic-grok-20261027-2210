[{"t0": 0.0, "t1": 3.6, "text": "你名字就叫中国"}, {"t0": 3.6, "t1": 8.36, "text": "古老的东方有一群人"}, {"t0": 8.36, "t1": 13.08, "text": "他们全都是龙的传人"}, {"t0": 13.08, "t1": 17.68, "text": "鸡龙脚底下我承战"}, {"t0": 17.68, "t1": 22.4, "text": "长城以后是龙的串人"}, {"t0": 22.4, "t1": 27.0, "text": "黑眼睛黑头发黄皮肤"}, {"t0": 27.0, "t1": 30.0, "text": "總永遠 遠是龍的船"}]