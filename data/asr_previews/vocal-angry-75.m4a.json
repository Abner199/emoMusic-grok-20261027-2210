[{"t0": 0.0, "t1": 4.32, "text": "大声尖叫 但这话没用"}, {"t0": 4.32, "t1": 6.56, "text": "大家只会心胸"}, {"t0": 6.56, "t1": 10.88, "text": "或改变自己发现大有不同"}, {"t0": 10.88, "t1": 15.28, "text": "新一代的朋友我们好好地加油"}, {"t0": 15.28, "t1": 17.84, "text": "大家一起大声地说"}, {"t0": 17.84, "t1": 20.12, "text": "Nana Nana Nana"}, {"t0": 20.12, "t1": 21.68, "text": "Nana Nanna"}, {"t0": 21.68, "t1": 24.44, "text": "我可以改变时间"}, {"t0": 24.44, "t1": 27.04, "text": "改变日记"}, {"t0": 27.04, "t1": 29.04, "text": "改变故墨"}, {"t0": 29.04, "t1": 30.04, "text": "我只要一直在你身邊"}]