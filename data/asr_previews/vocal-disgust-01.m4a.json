[{"t0": 0.0, "t1": 4.0, "text": "很多机会像 只人一样的无畏"}, {"t0": 4.0, "t1": 9.0, "text": "放纵我心里的鬼 可是我不悲"}, {"t0": 9.0, "t1": 13.0, "text": "臭八卦呀呀"}, {"t0": 13.0, "t1": 16.0, "text": "能否别把灯打开"}, {"t0": 16.0, "t1": 19.0, "text": "我要的爱呀呀"}, {"t0": 19.0, "t1": 24.0, "text": "触摸在 几黑一片的舞台"}, {"t0": 24.0, "t1": 28.0, "text": "臭吧呀呀呀"}, {"t0": 28.0, "t1": 30.0, "text": "在這曖昧"}]