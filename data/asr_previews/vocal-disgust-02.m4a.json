[{"t0": 0.0, "t1": 6.0, "text": "我只想看看你怎么演"}, {"t0": 6.0, "t1": 9.0, "text": "你难过的太表面"}, {"t0": 9.0, "t1": 12.0, "text": "像没天赋的演员"}, {"t0": 12.0, "t1": 17.0, "text": "观众一眼能看见"}, {"t0": 17.0, "t1": 20.0, "text": "该配合你演出的我"}, {"t0": 20.0, "t1": 22.0, "text": "掩饰而不见"}, {"t0": 22.0, "t1": 25.0, "text": "再逼一个最爱你的人"}, {"t0": 25.0, "t1": 27.0, "text": "进行表演"}, {"t0": 27.0, "t1": 29.0, "text": "什么时候我们"}, {"t0": 29.0, "t1": 30.0, "text": "我們開始"}]