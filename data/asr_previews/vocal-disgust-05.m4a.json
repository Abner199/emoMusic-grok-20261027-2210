[{"t0": 0.0, "t1": 4.36, "text": "还是是寂寞的无聊笑签"}, {"t0": 4.36, "t1": 7.56, "text": "相眼 隐称一灯光圈"}, {"t0": 7.56, "t1": 11.08, "text": "和她的照片就摆在手边"}, {"t0": 11.08, "t1": 17.44, "text": "叉叉两个人 笑得多甜"}, {"t0": 17.44, "t1": 21.36, "text": "开始总是分分钟 都秒不可言"}, {"t0": 21.36, "t1": 24.96, "text": "谁都因为热情 她永不会见"}, {"t0": 24.96, "t1": 29.96, "text": "除了激情退去后的 那一点点缺"}]