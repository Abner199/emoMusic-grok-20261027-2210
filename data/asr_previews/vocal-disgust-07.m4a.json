[{"t0": 0.0, "t1": 3.4, "text": "幸福轻得太沉重"}, {"t0": 3.4, "t1": 7.12, "text": "过度适用 无恙不通"}, {"t0": 7.12, "t1": 11.36, "text": "拦手头晃 空洞了的通空"}, {"t0": 11.36, "t1": 14.64, "text": "终于逃空 终于有时无终"}, {"t0": 14.64, "t1": 18.4, "text": "得不到的永远在骚动"}, {"t0": 18.4, "t1": 22.12, "text": "被骗乃得 都有时无空"}, {"t0": 22.12, "t1": 26.32, "text": "玫瑰的红 容易受伤的梦"}, {"t0": 26.32, "t1": 29.96, "text": "我在手中却离世与之风游"}]