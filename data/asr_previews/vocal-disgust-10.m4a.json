[{"t0": 0.0, "t1": 4.0, "text": "抬著最善的身 蚊十分感慨"}, {"t0": 4.0, "t1": 8.0, "text": "有人來拍照要記住拆袋"}, {"t0": 8.0, "t1": 12.0, "text": "你當我是否誇大"}, {"t0": 12.0, "t1": 16.0, "text": "誇張只因我懇怕"}, {"t0": 16.0, "t1": 21.0, "text": "似木頭似石頭的 畫得到著耳膜"}, {"t0": 21.0, "t1": 26.0, "text": "其實花費望幾次 放大來演吧"}, {"t0": 26.0, "t1": 28.0, "text": "我愛你 愛你 我愛你"}, {"t0": 28.0, "t1": 30.0, "text": "我愛你 你愛我 我愛你"}, {"t0": 30.0, "t1": 32.0, "text": "我愛你"}, {"t0": 32.0, "t1": 34.0, "text": "我愛你"}, {"t0": 34.0, "t1": 36.0, "text": "我愛你"}, {"t0": 36.0, "t1": 38.0, "text": "我愛你"}, {"t0": 38.0, "t1": 40.0, "text": "我愛你"}, {"t0": 40.0, "t1": 42.0, "text": "我愛你"}, {"t0": 42.0, "t1": 44.0, "text": "我愛你"}, {"t0": 44.0, "t1": 46.0, "text": "我愛你"}, {"t0": 46.0, "t1": 48.0, "text": "我愛你"}, {"t0": 48.0, "t1": 50.0, "text": "我愛你"}, {"t0": 50.0, "t1": 52.0, "text": "我愛你"}, {"t0": 52.0, "t1": 54.0, "text": "我愛你"}]