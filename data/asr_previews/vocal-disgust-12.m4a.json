[{"t0": 0.0, "t1": 3.64, "text": "与了多少个念头"}, {"t0": 3.64, "t1": 6.0, "text": "仿佛足够"}, {"t0": 6.0, "t1": 10.24, "text": "写一套错爱的春秋"}, {"t0": 10.24, "t1": 13.84, "text": "如果以后你还想为谁"}, {"t0": 13.84, "t1": 16.92, "text": "浪费美好时候"}, {"t0": 16.92, "t1": 20.24, "text": "现在只能在我的胸膛"}, {"t0": 20.24, "t1": 27.44, "text": "毫无保留"}, {"t0": 27.44, "t1": 29.96, "text": "不想折磨大坏"}]