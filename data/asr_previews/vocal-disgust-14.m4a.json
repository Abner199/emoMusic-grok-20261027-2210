[{"t0": 0.0, "t1": 6.0, "text": "畢竟難得 有過最佳選擇"}, {"t0": 6.0, "t1": 11.0, "text": "從前供你 速失把揪傾動 笑到不夠"}, {"t0": 11.0, "t1": 14.0, "text": "我有痛快過 你有沒有"}, {"t0": 14.0, "t1": 18.0, "text": "很多東西 今生只可及你"}, {"t0": 18.0, "t1": 22.0, "text": "保守 知道永久 別人如何明白頭"}, {"t0": 22.0, "t1": 25.0, "text": "實實坐在 踏入光我宇宙"}, {"t0": 25.0, "t1": 28.0, "text": "即使相處到 有個裂口"}, {"t0": 28.0, "t1": 30.0, "text": "命運決定了解"}]