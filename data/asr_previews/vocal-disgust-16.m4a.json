[{"t0": 0.0, "t1": 4.6, "text": "我存心敷衍"}, {"t0": 4.6, "t1": 8.4, "text": "這些逃路的情節"}, {"t0": 8.4, "t1": 11.84, "text": "藏帶的傷了太滅"}, {"t0": 11.84, "t1": 15.36, "text": "是不是分開一定要留念"}, {"t0": 15.36, "t1": 22.56, "text": "才覺得不那麼隨便"}, {"t0": 22.56, "t1": 24.4, "text": "你要的去拿走"}, {"t0": 24.4, "t1": 26.16, "text": "把回憶化成空"}, {"t0": 26.16, "t1": 28.0, "text": "不要再胡感受"}, {"t0": 28.0, "t1": 29.64, "text": "里面的游泳爆料"}]