[{"t0": 0.0, "t1": 6.0, "text": "日子開始過 我沒你照樣過"}, {"t0": 6.0, "t1": 11.0, "text": "不會很難受 我會默默的接受"}, {"t0": 11.0, "t1": 16.0, "text": "反正在一起著你 我都有看見過"}, {"t0": 16.0, "t1": 18.0, "text": "就足夠"}, {"t0": 18.0, "t1": 24.0, "text": "我的溫暖 你的冷漠到愛情露了"}, {"t0": 24.0, "t1": 29.0, "text": "如果愛情化在起舞的裝飾的模糊"}, {"t0": 29.0, "t1": 30.0, "text": "字幕by索兰娅"}]