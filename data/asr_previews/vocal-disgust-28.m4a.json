[{"t0": 0.0, "t1": 6.0, "text": "終於他打不了一桶芙花"}, {"t0": 6.0, "t1": 8.0, "text": "努力盡花"}, {"t0": 8.0, "t1": 12.0, "text": "小動物世界都太扎"}, {"t0": 12.0, "t1": 16.0, "text": "祖先一抹去朝陽"}, {"t0": 16.0, "t1": 18.0, "text": "相愛相殺"}, {"t0": 18.0, "t1": 22.0, "text": "一定有更好的辦法"}, {"t0": 22.0, "t1": 26.0, "text": "盼閉下誰先歸下"}, {"t0": 26.0, "t1": 29.0, "text": "不再盡花"}, {"t0": 29.0, "t1": 30.0, "text": "永不适合"}]