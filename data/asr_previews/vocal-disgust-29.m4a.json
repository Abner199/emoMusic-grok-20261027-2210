[{"t0": 0.0, "t1": 3.0, "text": "便宜得春春"}, {"t0": 3.0, "t1": 6.0, "text": "捨在情歌的誠感"}, {"t0": 6.0, "t1": 9.0, "text": "還能噴心慕"}, {"t0": 9.0, "t1": 12.0, "text": "要是愛不可感動"}, {"t0": 12.0, "t1": 15.0, "text": "人族土的歌詞"}, {"t0": 15.0, "t1": 18.0, "text": "煽動你賊人"}, {"t0": 18.0, "t1": 21.0, "text": "誰人有相信"}, {"t0": 21.0, "t1": 24.0, "text": "一世一生這夫妻對白"}, {"t0": 24.0, "t1": 27.0, "text": "來把送給你"}, {"t0": 27.0, "t1": 29.0, "text": "要幾百萬人流淚"}]