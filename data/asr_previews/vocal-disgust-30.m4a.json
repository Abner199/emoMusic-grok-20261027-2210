[{"t0": 0.0, "t1": 6.0, "text": "前來自首 寂寞因此欠我手"}, {"t0": 6.0, "t1": 10.0, "text": "隨下了他手信後"}, {"t0": 10.0, "t1": 13.0, "text": "我已得到你沒有"}, {"t0": 13.0, "t1": 19.0, "text": "但你我至少往後成為了物有"}, {"t0": 19.0, "t1": 23.0, "text": "比想像你最掛念誰"}, {"t0": 23.0, "t1": 26.0, "text": "眼睛在我身邊竟是誰"}, {"t0": 26.0, "t1": 29.92, "text": "想 緊急這站裡 想要越台南"}]