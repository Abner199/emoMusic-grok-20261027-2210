[{"t0": 0.0, "t1": 3.0, "text": "如果感情会挣扎"}, {"t0": 3.0, "t1": 5.0, "text": "没有说的如牙"}, {"t0": 5.0, "t1": 9.0, "text": "把挽回的手放下"}, {"t0": 9.0, "t1": 13.0, "text": "镜子里的人说假话"}, {"t0": 13.0, "t1": 18.0, "text": "微信的样子你决定了吗"}, {"t0": 18.0, "t1": 22.0, "text": "窗窿或者左右"}, {"t0": 22.0, "t1": 27.0, "text": "要不我先说话"}]