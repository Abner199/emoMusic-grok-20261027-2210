[{"t0": 0.0, "t1": 3.8, "text": "牆壁水順風過"}, {"t0": 3.8, "t1": 5.92, "text": "擁抱恨恨"}, {"t0": 5.92, "t1": 9.72, "text": "所以愛上你幾乎"}, {"t0": 9.72, "t1": 12.0, "text": "太溫水要記憶"}, {"t0": 12.0, "t1": 15.76, "text": "也被信守過"}, {"t0": 15.76, "t1": 17.84, "text": "開除易能動心"}, {"t0": 17.84, "t1": 21.76, "text": "請不要笑我太低等"}, {"t0": 21.76, "t1": 24.04, "text": "以前自然冷冬"}, {"t0": 24.04, "t1": 27.72, "text": "渴望難自禁"}, {"t0": 27.72, "t1": 29.92, "text": "無路密沉玉生"}, {"t0": 29.92, "t1": 31.92, "text": "字幕by索兰娅"}]