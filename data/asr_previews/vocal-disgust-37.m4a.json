[{"t0": 0.0, "t1": 3.56, "text": "自我主当者"}, {"t0": 3.56, "t1": 6.12, "text": "我说算我笨"}, {"t0": 6.12, "t1": 8.72, "text": "软不笼动的耳衡"}, {"t0": 8.72, "t1": 11.32, "text": "只为一世的气氛"}, {"t0": 11.32, "t1": 14.52, "text": "搞一肚子的气氾"}, {"t0": 14.52, "t1": 15.48, "text": "没看到你"}, {"t0": 15.48, "t1": 16.76, "text": "我就想到过去"}, {"t0": 16.76, "t1": 19.36, "text": "终于可让我卸传到脑子里去"}, {"t0": 19.36, "t1": 22.4, "text": "我的心里只会永远的痕迹"}, {"t0": 22.4, "t1": 24.8, "text": "我心里只會永远痕远"}, {"t0": 24.8, "t1": 25.8, "text": "你和别人"}, {"t0": 25.8, "t1": 27.12, "text": "之前又何来去"}, {"t0": 27.12, "t1": 29.68, "text": "对我一个人在这里追的空气"}, {"t0": 29.68, "t1": 31.68, "text": "字幕by索兰娅"}]