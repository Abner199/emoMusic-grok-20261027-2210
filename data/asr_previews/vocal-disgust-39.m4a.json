[{"t0": 0.0, "t1": 5.0, "text": "只差一點點才可以再會面"}, {"t0": 5.0, "t1": 9.0, "text": "彷彿應該一早見過"}, {"t0": 9.0, "t1": 13.0, "text": "但直行直過只差一個眼波"}, {"t0": 13.0, "t1": 21.0, "text": "將彼此錯誤"}, {"t0": 21.0, "t1": 25.0, "text": "只兩秒踏上地下天"}, {"t0": 25.0, "t1": 28.0, "text": "能與你碰上魔"}, {"t0": 28.0, "t1": 30.0, "text": "愈看淺濕暴"}]