[{"t0": 0.0, "t1": 4.88, "text": "我才懶得給你解藥"}, {"t0": 4.88, "t1": 8.28, "text": "反正你愛來這一套"}, {"t0": 8.28, "t1": 10.8, "text": "為愛情這樣"}, {"t0": 10.8, "t1": 13.92, "text": "難道不是你"}, {"t0": 13.92, "t1": 19.68, "text": "一直依賴戒不掉的癖好"}, {"t0": 19.68, "t1": 25.28, "text": "你在想誰想到睡不著"}, {"t0": 25.28, "t1": 27.68, "text": "你應該覺得驕傲"}, {"t0": 27.68, "t1": 29.68, "text": "很多人相识连言"}]