[{"t0": 0.0, "t1": 6.0, "text": "爱是爱情"}, {"t0": 6.0, "t1": 10.0, "text": "一步一步吞噬着我的心"}, {"t0": 10.0, "t1": 15.0, "text": "还像你我失去了自己"}, {"t0": 15.0, "t1": 18.0, "text": "爱得那么认真"}, {"t0": 18.0, "t1": 21.0, "text": "爱得那麼认真"}, {"t0": 21.0, "t1": 25.0, "text": "可还是听见了你说不可能"}, {"t0": 25.0, "t1": 29.0, "text": "已经十几年没小学的伤害"}, {"t0": 29.0, "t1": 30.0, "text": "Till I'm here"}]