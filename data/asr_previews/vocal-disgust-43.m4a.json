[{"t0": 0.0, "t1": 3.08, "text": "刮剑线软 不想承念人"}, {"t0": 3.08, "t1": 6.84, "text": "要能力变然 不是为了抓捏有牵纷"}, {"t0": 6.84, "t1": 10.24, "text": "我为我的虔诚 希望我写的歌里面"}, {"t0": 10.24, "t1": 11.64, "text": "有更好的合成声"}, {"t0": 11.64, "t1": 18.24, "text": "涉嫌滴滴的 你还记得吗"}, {"t0": 18.24, "t1": 24.76, "text": "说去心里话 你还怀疑吗"}, {"t0": 24.76, "t1": 28.16, "text": "第一次发唱片 终于骂淡写"}, {"t0": 28.16, "t1": 29.86, "text": "從自在的場面"}]