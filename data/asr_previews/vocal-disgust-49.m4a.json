[{"t0": 0.0, "t1": 3.56, "text": "敬夜首"}, {"t0": 3.56, "t1": 7.44, "text": "摩天大楼太稀有"}, {"t0": 7.44, "t1": 10.4, "text": "人人可归附有"}, {"t0": 10.4, "t1": 14.2, "text": "表情温柔怕羡愁"}, {"t0": 14.2, "t1": 18.84, "text": "美人吐出骨头"}, {"t0": 18.84, "t1": 24.0, "text": "你们谁为一举榜首"}, {"t0": 24.0, "t1": 27.92, "text": "摩天的楼云里走"}, {"t0": 27.92, "t1": 29.92, "text": "喜倔一生"}]