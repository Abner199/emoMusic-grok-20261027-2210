[{"t0": 0.0, "t1": 4.6, "text": "时间的皱褶都是空白"}, {"t0": 4.6, "t1": 8.6, "text": "有人在念怀 有人期待"}, {"t0": 8.6, "t1": 12.4, "text": "欲望的首歌都是腐坏"}, {"t0": 12.4, "t1": 17.4, "text": "没有人在关盖"}, {"t0": 17.4, "t1": 22.0, "text": "等它始终多时的爱坠落下来"}, {"t0": 22.0, "t1": 26.0, "text": "在末日都后白无聊来"}, {"t0": 26.0, "t1": 30.0, "text": "斑驳的黑白 阻止平台"}]