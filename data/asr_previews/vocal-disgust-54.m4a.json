[{"t0": 0.0, "t1": 3.4, "text": "到夜看她嘟嘟抖入都拿到碗"}, {"t0": 3.4, "t1": 7.0, "text": "看眼前是天亮看眼色中都等人在"}, {"t0": 7.0, "t1": 10.6, "text": "我多敢用看前看后的还是看后来"}, {"t0": 10.6, "t1": 12.0, "text": "这个这个这个这个"}, {"t0": 12.0, "t1": 14.6, "text": "打打打打我越来越奇怪"}, {"t0": 14.6, "t1": 18.4, "text": "我对我不知什么生活和生活"}, {"t0": 18.4, "t1": 22.0, "text": "不知我不知是有可能追问"}, {"t0": 22.0, "t1": 25.6, "text": "我对我回死的未来可不是存在"}, {"t0": 25.6, "t1": 29.0, "text": "前途才似乎清楚什么是未来"}, {"t0": 29.0, "t1": 30.0, "text": "字幕by索兰娅"}]