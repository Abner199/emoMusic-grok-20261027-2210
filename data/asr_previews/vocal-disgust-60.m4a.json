[{"t0": 0.0, "t1": 5.0, "text": "差不多的童年"}, {"t0": 5.0, "t1": 10.5, "text": "最終差不多的漂亮"}, {"t0": 10.5, "t1": 16.0, "text": "他們差不多的願望"}, {"t0": 16.0, "t1": 22.0, "text": "牽著他們你的方向"}, {"t0": 22.0, "t1": 24.0, "text": "差不多的你 差不多的我"}, {"t0": 24.0, "t1": 26.0, "text": "差不多的他 差不多的傻"}, {"t0": 26.0, "t1": 28.0, "text": "聽著差不多的廢話"}, {"t0": 28.0, "t1": 30.0, "text": "多了那些乌鸟又继续啊"}]