[{"t0": 0.0, "t1": 3.0, "text": "走得很遠"}, {"t0": 3.0, "t1": 6.8, "text": "也許你已經放棄我"}, {"t0": 6.8, "t1": 10.5, "text": "也許已經很難回頭"}, {"t0": 10.5, "t1": 14.0, "text": "我知道身體錯過"}, {"t0": 14.0, "t1": 17.6, "text": "趁在給我一個理由"}, {"t0": 17.6, "t1": 21.8, "text": "說你不愛我"}, {"t0": 21.8, "t1": 25.6, "text": "就算是我不懂"}, {"t0": 25.6, "t1": 29.2, "text": "能不能原諒我"}, {"t0": 29.2, "t1": 31.2, "text": "小明星大跟班"}]