[{"t0": 0.0, "t1": 3.0, "text": " Yeah, you talked to her"}, {"t0": 3.0, "t1": 5.0, "text": " When we were together"}, {"t0": 5.0, "t1": 8.0, "text": " Loved you, it's your worst"}, {"t0": 8.0, "t1": 10.0, "text": " But that didn't matter"}, {"t0": 10.0, "t1": 13.0, "text": " It took you two weeks"}, {"t0": 13.0, "t1": 15.0, "text": " To go off and date her"}, {"t0": 15.0, "t1": 17.0, "text": " Guess you didn't cheat"}, {"t0": 17.0, "t1": 20.0, "text": " I think you're still a traitor"}, {"t0": 25.0, "t1": 27.0, "text": " God, I wish that you had thought this through"}, {"t0": 27.0, "t1": 29.0, "text": " Before I went and fell in love with you"}]