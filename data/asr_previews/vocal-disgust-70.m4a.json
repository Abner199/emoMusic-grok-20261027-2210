[{"t0": 0.0, "t1": 2.0, "text": "准备来信"}, {"t0": 2.0, "t1": 6.4, "text": "我怀念起过小的客座地"}, {"t0": 6.4, "t1": 9.0, "text": "幻念只用签笔写书记"}, {"t0": 9.0, "t1": 12.4, "text": "记录那最艳势的魅力"}, {"t0": 12.4, "t1": 16.0, "text": "记录第一次遇见的你追求"}, {"t0": 16.0, "t1": 19.4, "text": "不管我遇见你谁从未去"}, {"t0": 19.4, "t1": 22.8, "text": "想过这辈子注定一个年期"}, {"t0": 22.8, "t1": 26.2, "text": "最后再一个慢慢回"}, {"t0": 26.2, "t1": 29.6, "text": "没有了过去我将往事抽离"}, {"t0": 29.6, "t1": 30.1, "text": "獨廣"}]