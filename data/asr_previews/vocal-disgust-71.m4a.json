[{"t0": 0.0, "t1": 4.84, "text": "誰當初想擺脫地圍繞左右"}, {"t0": 4.84, "t1": 9.48, "text": "過後誰人被遙控於世界盡頭"}, {"t0": 9.48, "t1": 14.52, "text": "勒到呼吸困難才知變車線木偶"}, {"t0": 14.52, "t1": 20.28, "text": "這更善其實說到底誰難捏在手"}, {"t0": 20.28, "t1": 25.2, "text": "不醉不散只等你及另一對手渴望"}, {"t0": 25.2, "t1": 29.88, "text": "那時青絲不會用上於生來量度"}, {"t0": 29.88, "t1": 31.88, "text": "字幕by索兰娅"}]