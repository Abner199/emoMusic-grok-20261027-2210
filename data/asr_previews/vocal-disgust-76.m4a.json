[{"t0": 0.0, "t1": 4.6, "text": "平時窗外的陰天"}, {"t0": 4.6, "t1": 10.8, "text": "一句抱歉都將在嘴邊"}, {"t0": 10.8, "t1": 13.4, "text": "我搞不懂"}, {"t0": 13.4, "t1": 17.4, "text": "我們到底怎麼了"}, {"t0": 17.4, "t1": 20.4, "text": "城市的背後"}, {"t0": 20.4, "t1": 25.0, "text": "是否住著傷口"}, {"t0": 25.0, "t1": 27.6, "text": "我想不懂"}, {"t0": 27.6, "t1": 29.92, "text": "我们的爱怎么"}]