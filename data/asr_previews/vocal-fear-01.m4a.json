[{"t0": 0.0, "t1": 4.5, "text": "那些短视的情敌的散落在身边"}, {"t0": 4.5, "t1": 7.5, "text": "噢 我的眼睛没有抒抗到眼睛"}, {"t0": 7.5, "t1": 10.0, "text": "失去你的爱一开始不够"}, {"t0": 10.0, "t1": 13.0, "text": "失去你 我连笑容都会有意义"}, {"t0": 13.0, "t1": 15.0, "text": "纵散散起来带了无敌"}, {"t0": 15.0, "t1": 16.5, "text": "刷下我的伤心"}, {"t0": 16.5, "t1": 18.5, "text": "像一颗黑暗水的灰烬"}, {"t0": 18.5, "t1": 20.5, "text": "我临继变了自己的温暖温的"}, {"t0": 20.5, "t1": 22.5, "text": "记得爱情恨"}, {"t0": 23.5, "t1": 26.5, "text": "对你彈着下巴闹着眼睛"}, {"t0": 26.5, "t1": 29.5, "text": "记得我失去的爱情"}, {"t0": 29.5, "t1": 30.0, "text": "by bwd6"}]