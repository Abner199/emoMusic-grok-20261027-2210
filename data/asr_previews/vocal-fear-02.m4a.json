[{"t0": 0.0, "t1": 13.0, "text": "Zither Harp"}, {"t0": 13.0, "t1": 15.5, "text": "1983年小巷十二月起闹"}, {"t0": 15.5, "t1": 18.0, "text": "演的第幾張大體積繼續退巷"}, {"t0": 18.0, "t1": 21.0, "text": "潔積色的那下一行是男顏頭的屋"}, {"t0": 21.0, "t1": 23.5, "text": "我將顧問的書寫的沉默的對我哭"}, {"t0": 23.5, "t1": 26.0, "text": "哭書寫沒看見胖胎原型廣場"}, {"t0": 26.0, "t1": 29.0, "text": "回家只是悲傷因為我花大規章"}, {"t0": 29.0, "t1": 30.0, "text": "BREAK UP"}]