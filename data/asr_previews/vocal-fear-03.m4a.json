[{"t0": 0.0, "t1": 7.0, "text": "丹麦之舞 漫漫的波折的奔暮"}, {"t0": 7.0, "t1": 15.0, "text": "古堡里一片荒芜 赶忙找找的尼图"}, {"t0": 15.0, "t1": 18.0, "text": "不畏气 受罢的胖女巫"}, {"t0": 18.0, "t1": 22.0, "text": "用拉丁万年 走与鸭的雾"}, {"t0": 22.0, "t1": 25.0, "text": "她养的黑马 笑起来像哭"}, {"t0": 25.0, "t1": 29.0, "text": "啦啦啦 呜 用血清救定冷战部"}, {"t0": 29.0, "t1": 30.0, "text": "大叔"}]