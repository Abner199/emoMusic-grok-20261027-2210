[{"t0": 0.0, "t1": 6.0, "text": "有微量的程度 暂时很离不失"}, {"t0": 6.0, "t1": 8.5, "text": "半路有我负责地球"}, {"t0": 8.5, "t1": 11.5, "text": "无奈的觉悟真的更残酷"}, {"t0": 11.5, "t1": 14.0, "text": "一切都为了懂我是那段路"}, {"t0": 14.0, "t1": 16.7, "text": "最不善的无意摸了一堵"}, {"t0": 16.7, "t1": 19.0, "text": "谁惊扰的不停住"}, {"t0": 19.0, "t1": 24.5, "text": "还来不及哭残哭的子弹就带走温度"}, {"t0": 24.5, "t1": 26.0, "text": "我们每个人都有罪"}, {"t0": 26.0, "t1": 27.5, "text": "反正不懂得罪"}, {"t0": 27.5, "t1": 29.0, "text": "我能决定是对"}, {"t0": 29.0, "t1": 30.0, "text": "誰又可以要解釋"}]