[{"t0": 0.0, "t1": 2.0, "text": "我拎指的黎眼睛"}, {"t0": 2.0, "t1": 3.4, "text": "穿了一身 哎呦"}, {"t0": 3.4, "t1": 5.2, "text": "睡了太久睡了太瘦"}, {"t0": 5.2, "t1": 7.0, "text": "誰知明明被我偷走"}, {"t0": 7.0, "t1": 9.4, "text": "心情學了 卻沒我看過"}, {"t0": 9.4, "t1": 12.6, "text": "不過今夜的情 我不是累啊難得"}, {"t0": 12.6, "t1": 17.2, "text": "不會一層又一層的把夢 偷偷逃走"}, {"t0": 17.2, "t1": 21.4, "text": "我擔心上眼睛 因為我都沒見你"}, {"t0": 21.4, "t1": 24.6, "text": "但相信你 我決定"}, {"t0": 24.6, "t1": 28.8, "text": "我擔起等待你 和你慢慢的相遇"}, {"t0": 28.8, "t1": 29.8, "text": "我的爱情"}]