[{"t0": 0.0, "t1": 3.0, "text": "喔咿喔咿 喔咿"}, {"t0": 3.0, "t1": 5.0, "text": "你喝了冷著的想法"}, {"t0": 5.0, "t1": 7.0, "text": "嘴巴用武士刀逼花"}, {"t0": 7.0, "t1": 10.0, "text": "我一個人在家 乖乖在學插花"}, {"t0": 10.0, "t1": 12.0, "text": "嘿嘿嘿 解釋了"}, {"t0": 12.0, "t1": 14.0, "text": "一起逆殺系 螢光浪漫裡"}, {"t0": 14.0, "t1": 16.0, "text": "用一種神秘 連接來攻擊"}, {"t0": 16.0, "t1": 18.0, "text": "一起來殺系 黑黑裡偷襲"}, {"t0": 18.0, "t1": 21.0, "text": "去攻擊 煙霧打無忌"}, {"t0": 21.0, "t1": 23.0, "text": "一起逆杀系 藍色的浮雲"}, {"t0": 23.0, "t1": 25.0, "text": "要去盪過去 重新成唯一"}, {"t0": 25.0, "t1": 28.0, "text": "一起逆死系 一生要徹底擁擠"}, {"t0": 28.0, "t1": 30.0, "text": "G XOXO 2G"}]