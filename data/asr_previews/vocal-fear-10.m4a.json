[{"t0": 0.0, "t1": 4.0, "text": "你和了冷静的想法"}, {"t0": 4.0, "t1": 6.0, "text": "最會用無視的筆劃"}, {"t0": 6.0, "t1": 9.0, "text": "我一個人在家乖乖的去插畫"}, {"t0": 9.0, "t1": 10.0, "text": "嗨 嗨嗨"}, {"t0": 10.0, "t1": 11.0, "text": "我要跟你們講"}, {"t0": 11.0, "t1": 12.0, "text": "一起逆散戲"}, {"t0": 12.0, "t1": 13.0, "text": "螢光了蠻藝"}, {"t0": 13.0, "t1": 14.0, "text": "用一種生命"}, {"t0": 14.0, "t1": 15.0, "text": "連接了孤寂"}, {"t0": 15.0, "t1": 16.0, "text": "一起递散戲"}, {"t0": 16.0, "t1": 17.0, "text": "黑暗的東西"}, {"t0": 17.0, "t1": 18.0, "text": "去忘記"}, {"t0": 18.0, "t1": 19.0, "text": "夜霧的武器"}, {"t0": 19.0, "t1": 20.0, "text": "一起逃逃戲"}, {"t0": 20.0, "t1": 21.0, "text": "冷靜的呼籲"}, {"t0": 21.0, "t1": 22.0, "text": "要去放過去"}, {"t0": 22.0, "t1": 23.0, "text": "重新成回憶"}, {"t0": 23.0, "t1": 25.0, "text": "一起逃避"}, {"t0": 25.0, "t1": 26.0, "text": "一生要徹底"}, {"t0": 26.0, "t1": 27.0, "text": "有忘記"}, {"t0": 27.0, "t1": 28.0, "text": "什麼是質疑"}, {"t0": 28.0, "t1": 30.0, "text": "記憶可說不是自己"}]