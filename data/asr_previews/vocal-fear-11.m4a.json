[{"t0": 0.0, "t1": 5.0, "text": "你发入血气没了离别"}, {"t0": 5.0, "t1": 10.0, "text": "我分享感动了谁"}, {"t0": 10.0, "t1": 14.0, "text": "要明月让回忆纠结"}, {"t0": 14.0, "t1": 17.0, "text": "爱在月光像晚辈"}, {"t0": 17.0, "t1": 22.0, "text": "你发入雪纷飞了眼泪"}, {"t0": 22.0, "t1": 26.0, "text": "我等待沧沧了谁"}, {"t0": 26.0, "t1": 29.4, "text": "红尘最威胁的"}]