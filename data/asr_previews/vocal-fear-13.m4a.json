[{"t0": 0.0, "t1": 5.0, "text": "梦醒来是谁在争态"}, {"t0": 5.0, "t1": 9.0, "text": "把结局打开"}, {"t0": 9.0, "t1": 13.0, "text": "哪怕如尘域的未来"}, {"t0": 13.0, "t1": 17.0, "text": "见不见谁来再"}, {"t0": 17.0, "t1": 21.0, "text": "我送你离开千里之外"}, {"t0": 21.0, "t1": 25.0, "text": "你无声黑白"}, {"t0": 25.0, "t1": 29.0, "text": "沉默年代或许不该"}]