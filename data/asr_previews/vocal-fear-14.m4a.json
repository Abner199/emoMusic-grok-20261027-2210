[{"t0": 0.0, "t1": 4.6, "text": "我只剩悲慧的小丑"}, {"t0": 4.6, "t1": 9.5, "text": "繁阶隔看多久的你陪伴送"}, {"t0": 9.5, "t1": 12.7, "text": "啊啊啊 人均散了后"}, {"t0": 12.7, "t1": 14.8, "text": "夜色多朦胧"}, {"t0": 14.8, "t1": 17.5, "text": "月光也会跟着我"}, {"t0": 17.5, "t1": 20.8, "text": "我不是孤独的小业"}, {"t0": 20.8, "t1": 22.8, "text": "你想了之后"}, {"t0": 22.8, "t1": 25.5, "text": "不需要记得我"}, {"t0": 25.5, "t1": 26.8, "text": "啊啊啊"}, {"t0": 26.8, "t1": 28.8, "text": "人心的时候"}, {"t0": 28.8, "t1": 29.92, "text": "啊 漫長的"}]