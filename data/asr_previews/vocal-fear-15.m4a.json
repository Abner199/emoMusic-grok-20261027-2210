[{"t0": 0.0, "t1": 3.9, "text": "嗨 我们的表情像是冰线一幅作业的疯癫"}, {"t0": 3.9, "t1": 7.2, "text": "不公开或者惊 惊动就算在四万块钱里"}, {"t0": 7.2, "t1": 11.5, "text": "看我只需要分三圈 进了这层年"}, {"t0": 11.5, "t1": 13.5, "text": "梦魇 你的脸"}, {"t0": 13.5, "t1": 15.9, "text": "还是回去拍着脸吧 看我的肺炎"}, {"t0": 15.9, "t1": 17.9, "text": "大声点 我听不见"}, {"t0": 17.9, "t1": 20.5, "text": "黑夜是闪闪我深情的夜"}, {"t0": 20.5, "t1": 22.7, "text": "你面前故意有不屑"}, {"t0": 22.7, "t1": 26.3, "text": "表情在天空里面 熬起温香脸"}, {"t0": 26.3, "t1": 29.9, "text": "水晶藏一個人 便是來轉彎"}]