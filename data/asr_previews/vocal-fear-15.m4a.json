[{"t0": 0.0, "t1": 3.1, "text": "嗨 我们的飘音声 组织线又顶着"}, {"t0": 3.1, "t1": 5.0, "text": "一朵光源 不空话会再进"}, {"t0": 5.0, "t1": 7.2, "text": "这东西就算在死亡的城里"}, {"t0": 7.2, "t1": 9.2, "text": "看我只需要分层圈"}, {"t0": 9.2, "t1": 13.5, "text": "那这正面 明月的脸"}, {"t0": 13.5, "t1": 15.9, "text": "还是会去拍一堆妹妹看我的表演"}, {"t0": 15.9, "t1": 17.9, "text": "大声点 我点不见"}, {"t0": 17.9, "t1": 20.5, "text": "没人思想 像我伤心的夜"}, {"t0": 20.5, "t1": 22.7, "text": "你变成光影又不现"}, {"t0": 22.7, "t1": 26.3, "text": "表演在天空里面 熬线温霜面"}, {"t0": 26.3, "t1": 29.9, "text": "是青苍蜜蜜 电视来传"}, {"t0": 29.9, "t1": 31.9, "text": "字幕by索兰娅"}]