[{"t0": 0.0, "t1": 2.76, "text": "轻轻梦 戒指换手一动"}, {"t0": 2.76, "t1": 6.52, "text": "给眼中一个梦 牙液成有笑容"}, {"t0": 6.52, "t1": 8.88, "text": "手中害怕血汗的汗包"}, {"t0": 8.88, "t1": 10.8, "text": "翻面那只牛肌膜"}, {"t0": 10.8, "t1": 14.08, "text": "你永远都猜不到"}, {"t0": 14.08, "t1": 15.64, "text": "每当我在台上演出"}, {"t0": 15.64, "t1": 17.8, "text": "冷嘟嘟哭"}, {"t0": 17.8, "t1": 21.36, "text": "你就在底下躲透着我的嘟哟"}, {"t0": 21.36, "t1": 23.92, "text": "不等待歌费数"}, {"t0": 23.92, "t1": 29.08, "text": "再叫爱说清楚"}, {"t0": 29.08, "t1": 30.08, "text": "你不肯定"}]