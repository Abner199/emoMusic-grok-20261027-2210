[{"t0": 0.0, "t1": 2.72, "text": "阳光放弃着最后一秒"}, {"t0": 2.72, "t1": 5.04, "text": "让世界被黑暗笼罩"}, {"t0": 5.04, "t1": 9.44, "text": "惩罚着人们的骄傲"}, {"t0": 9.44, "t1": 12.04, "text": "我忍受寒冷的骑傲"}, {"t0": 12.04, "t1": 14.4, "text": "和被疯狂往的抛销"}, {"t0": 14.4, "t1": 18.72, "text": "对命运错抵抗"}, {"t0": 18.72, "t1": 21.36, "text": "这事无法避免的好解"}, {"t0": 21.36, "t1": 23.4, "text": "不论你以为你是谁"}, {"t0": 23.4, "t1": 27.8, "text": "任何事无任何一切"}, {"t0": 27.8, "t1": 30.04, "text": "否惊惡的别冷漠"}]