[{"t0": 0.0, "t1": 17.2, "text": "再次能完美"}, {"t0": 17.2, "t1": 19.2, "text": "他们在 随便在"}, {"t0": 19.2, "t1": 20.6, "text": "步骤那边"}, {"t0": 20.6, "t1": 22.4, "text": "上彼此的信号"}, {"t0": 22.4, "t1": 24.2, "text": "才有个依靠"}, {"t0": 24.2, "t1": 26.2, "text": "有太多人 太多痴"}, {"t0": 26.2, "t1": 28.2, "text": "他在我们之间跑"}, {"t0": 28.2, "t1": 30.2, "text": "擦拳太多心了"}]