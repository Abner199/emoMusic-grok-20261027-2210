[{"t0": 0.0, "t1": 2.0, "text": "笑的背后"}, {"t0": 2.0, "t1": 4.0, "text": "暗藏危险的轮廓"}, {"t0": 4.0, "t1": 7.0, "text": "在你这放松的时候"}, {"t0": 7.0, "t1": 9.0, "text": "绝不带着任何干净"}, {"t0": 9.0, "t1": 11.0, "text": "就下手"}, {"t0": 11.0, "t1": 14.0, "text": "从来不会走"}, {"t0": 14.0, "t1": 17.0, "text": "开始的感觉 不会动 不会演"}, {"t0": 17.0, "t1": 19.0, "text": "放强的动作就像做梦"}, {"t0": 19.0, "t1": 21.0, "text": "幸福的作绝 温暖很暴动"}, {"t0": 21.0, "t1": 23.0, "text": "也许还期待"}, {"t0": 23.0, "t1": 25.0, "text": "只是知名的冲动"}, {"t0": 25.0, "t1": 26.0, "text": "你不懂我不懂"}, {"t0": 26.0, "t1": 29.0, "text": "究竟下手为什么存在"}, {"t0": 29.0, "t1": 30.0, "text": "你會愛"}]