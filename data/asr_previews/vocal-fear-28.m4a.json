[{"t0": 0.0, "t1": 5.0, "text": "以为你心门"}, {"t0": 5.0, "t1": 8.0, "text": "我祈求星辰"}, {"t0": 8.0, "t1": 11.0, "text": "月儿来作证"}, {"t0": 11.0, "t1": 14.0, "text": "用尽一生"}, {"t0": 14.0, "t1": 18.0, "text": "也愿意取得"}, {"t0": 18.0, "t1": 22.0, "text": "终会有一天"}, {"t0": 22.0, "t1": 25.0, "text": "把心安完成"}, {"t0": 25.0, "t1": 29.0, "text": "带着你飞奔招"}]