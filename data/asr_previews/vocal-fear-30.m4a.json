[{"t0": 0.0, "t1": 3.4, "text": "心虚却在游浪潮"}, {"t0": 3.4, "t1": 7.4, "text": "占了千次的情丝却断不了"}, {"t0": 7.4, "t1": 11.4, "text": "百转牵扯它将我围绕"}, {"t0": 11.4, "t1": 15.2, "text": "有人问过你究竟是哪里好"}, {"t0": 15.2, "t1": 19.4, "text": "这么多年我还忘不了"}, {"t0": 19.4, "t1": 23.2, "text": "春风在美丽鼻鼓上你的笑"}, {"t0": 23.2, "t1": 27.6, "text": "没见过你个人都会明了"}, {"t0": 27.6, "t1": 29.96, "text": "是闺蜜的心跳也好"}]