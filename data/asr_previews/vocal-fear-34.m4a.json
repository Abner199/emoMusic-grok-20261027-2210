[{"t0": 0.0, "t1": 2.8, "text": "哦 老膠紙"}, {"t0": 2.8, "t1": 6.6, "text": "踏著腳在懷念作天的你"}, {"t0": 6.6, "t1": 10.4, "text": "夜視深著前世全廢不來"}, {"t0": 10.4, "t1": 14.0, "text": "若是你在明日能得一見"}, {"t0": 14.0, "t1": 17.8, "text": "就讓我在懷內重得溫暖"}, {"t0": 17.8, "t1": 21.6, "text": "若不願冷的牽連我在我的心裡邊"}, {"t0": 21.6, "t1": 25.6, "text": "始終只有你方可 令世去的心再見"}]