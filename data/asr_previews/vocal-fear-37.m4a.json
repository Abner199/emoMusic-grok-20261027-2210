[{"t0": 0.0, "t1": 2.0, "text": "我的爱恋"}, {"t0": 2.0, "t1": 5.0, "text": "我那是糊涂"}, {"t0": 5.0, "t1": 9.0, "text": "不明白为何你会哭"}, {"t0": 9.0, "t1": 17.0, "text": "后之后却以后礼物"}, {"t0": 17.0, "t1": 19.0, "text": "冬节那时间"}, {"t0": 19.0, "t1": 21.0, "text": "冬节初音的一天"}, {"t0": 21.0, "t1": 23.0, "text": "冬节的爱恋"}, {"t0": 23.0, "t1": 25.0, "text": "冬节稳定的瞬间"}, {"t0": 25.0, "t1": 28.0, "text": "我也会疲倦"}, {"t0": 28.0, "t1": 30.0, "text": "你的笑臉在我身上"}]