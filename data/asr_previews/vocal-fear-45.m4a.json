[{"t0": 0.0, "t1": 3.0, "text": "带着我们的记忆"}, {"t0": 3.0, "t1": 6.0, "text": "我曾烦怒看回去"}, {"t0": 6.0, "t1": 9.0, "text": "这情况慢慢好玩去"}, {"t0": 9.0, "t1": 11.0, "text": "梦想穿过了西裔"}, {"t0": 11.0, "t1": 14.0, "text": "包含了多少的差异"}, {"t0": 14.0, "t1": 17.0, "text": "爱情像一本游击"}, {"t0": 17.0, "t1": 19.0, "text": "我会找寻它的秘语"}, {"t0": 19.0, "t1": 24.0, "text": "看 月涯晚下的泪光"}, {"t0": 24.0, "t1": 28.0, "text": "在思路之上被遗忘"}, {"t0": 28.0, "t1": 30.0, "text": "希望是誰的"}]