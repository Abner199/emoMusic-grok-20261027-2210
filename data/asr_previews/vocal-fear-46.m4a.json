[{"t0": 0.0, "t1": 10.0, "text": "心静静浮雕 情有无调"}, {"t0": 10.0, "t1": 14.0, "text": "回头再看 微微灯光"}, {"t0": 14.0, "t1": 17.0, "text": "无知几 直了不安"}, {"t0": 17.0, "t1": 20.0, "text": "重新约 无人记错"}, {"t0": 20.0, "t1": 24.0, "text": "心更未到晚安"}, {"t0": 24.0, "t1": 28.0, "text": "历历世远 茫茫鲜光"}, {"t0": 28.0, "t1": 30.0, "text": "明朝中 別來傾伏"}]