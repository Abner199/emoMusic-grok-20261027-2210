[{"t0": 0.0, "t1": 8.0, "text": "心靜靜復調 情有無疊"}, {"t0": 10.0, "t1": 14.0, "text": "回頭再看 未未登過"}, {"t0": 14.0, "t1": 17.0, "text": "無知己 直了不落"}, {"t0": 17.0, "t1": 20.0, "text": "藏身於 無人記錯"}, {"t0": 20.0, "t1": 24.0, "text": "心更未到晚霧"}, {"t0": 24.0, "t1": 28.0, "text": "來來世與 茫茫勝過"}, {"t0": 28.0, "t1": 30.0, "text": "明天見 別耐心"}]