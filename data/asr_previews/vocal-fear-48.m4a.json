[{"t0": 0.0, "t1": 6.2, "text": "范落苍"}, {"t0": 6.2, "t1": 11.6, "text": "我的爱 只说听不能听"}, {"t0": 11.6, "t1": 17.0, "text": "已经弄得不能说些曾经"}, {"t0": 17.0, "t1": 20.0, "text": "也可说着我是错的"}, {"t0": 20.0, "t1": 23.0, "text": "爱会曾变真真的"}, {"t0": 23.0, "t1": 28.0, "text": "也没谈到多少你需要的爱"}, {"t0": 28.0, "t1": 30.0, "text": "我不再拒绝"}]