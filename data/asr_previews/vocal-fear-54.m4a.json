[{"t0": 0.0, "t1": 4.0, "text": " But pay if and will it all the way?"}, {"t0": 6.0, "t1": 9.0, "text": " If and will it on the way?"}, {"t0": 10.0, "t1": 14.0, "text": " Don't turn away"}, {"t0": 15.0, "t1": 19.0, "text": " Don't try to hide"}, {"t0": 20.0, "t1": 25.0, "text": " Don't close your eyes"}, {"t0": 26.0, "t1": 29.0, "text": " Don't turn out the light"}]