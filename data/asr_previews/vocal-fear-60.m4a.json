[{"t0": 0.0, "t1": 4.64, "text": "拼著交際之力"}, {"t0": 4.64, "t1": 7.48, "text": "如果恐懼就像後劇"}, {"t0": 7.48, "t1": 10.36, "text": "那就讓它飛得無血液"}, {"t0": 10.36, "t1": 13.84, "text": "但我都決定"}, {"t0": 13.84, "t1": 20.0, "text": "我才能完全覺醒"}, {"t0": 20.0, "t1": 23.2, "text": "在暗的對面是光明"}, {"t0": 23.2, "t1": 26.32, "text": "光明後面是陰影"}, {"t0": 26.32, "t1": 29.92, "text": "这一切是谁有决定"}]