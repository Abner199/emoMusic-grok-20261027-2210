[{"t0": 0.0, "t1": 2.6, "text": "ハッピーで埋め尽くした"}, {"t0": 2.6, "t1": 3.3, "text": "Let's do it!"}, {"t0": 3.3, "t1": 5.3, "text": "Pieceまで行こうぜ"}, {"t0": 5.3, "t1": 7.7, "text": "いつかに立ちぼくのいいところ"}, {"t0": 7.7, "t1": 9.7, "text": "愛はバラマイター"}, {"t0": 9.7, "t1": 10.9, "text": "I love you!"}, {"t0": 10.9, "t1": 12.1, "text": "気出してくれ!"}, {"t0": 12.1, "t1": 14.1, "text": "全部バッテン笑ってくれ!"}, {"t0": 14.1, "t1": 15.3, "text": "My honey!"}, {"t0": 15.3, "t1": 16.2, "text": "Don't look me!"}, {"t0": 16.2, "t1": 22.3, "text": "Live in foster!"}, {"t0": 22.3, "t1": 24.3, "text": "何か忘れちゃってんの?"}, {"t0": 24.3, "t1": 25.3, "text": "Don't be a liar!"}, {"t0": 25.3, "t1": 26.5, "text": "Don't ever fall down!"}, {"t0": 26.5, "t1": 27.3, "text": "Don't talk me!"}, {"t0": 27.3, "t1": 28.8, "text": "Live in folder!"}, {"t0": 28.8, "t1": 29.3, "text": "Don't run around!"}, {"t0": 29.3, "t1": 29.8, "text": "by H."}]