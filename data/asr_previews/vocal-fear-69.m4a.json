[{"t0": 0.0, "t1": 2.0, "text": "走"}, {"t0": 2.0, "t1": 5.0, "text": "我突然想回個鄉"}, {"t0": 5.0, "t1": 7.0, "text": "向身邊全部閃耀"}, {"t0": 7.0, "t1": 10.0, "text": "虛夢在朋友來遙"}, {"t0": 10.0, "t1": 12.0, "text": "來到你的眼前了"}, {"t0": 12.0, "t1": 15.0, "text": "你為誰挖下的刀"}, {"t0": 15.0, "t1": 17.0, "text": "數位記住我的海"}, {"t0": 17.0, "t1": 22.0, "text": "我也換成了最嘲笑"}, {"t0": 22.0, "t1": 24.0, "text": "你的美"}, {"t0": 24.0, "t1": 26.0, "text": "已經給了誰"}, {"t0": 26.0, "t1": 29.0, "text": "覺得有追蹦"}, {"t0": 29.0, "t1": 30.0, "text": "你也不願意"}]