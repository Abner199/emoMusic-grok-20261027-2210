[{"t0": 0.0, "t1": 5.0, "text": "因此剩下难解的理念"}, {"t0": 5.0, "t1": 7.0, "text": "真实就真的"}, {"t0": 7.0, "t1": 14.0, "text": "用最不朽的诗歌"}, {"t0": 14.0, "t1": 16.0, "text": "我给你的爱却在心眼前"}, {"t0": 16.0, "t1": 21.0, "text": "什么爱都没说不了你 I'll be yours"}, {"t0": 21.0, "t1": 24.0, "text": "即使个世界有诸多花线"}, {"t0": 24.0, "t1": 29.0, "text": "你把伤得自己依然静静和紧"}, {"t0": 29.0, "t1": 30.0, "text": "我給你的愛"}]