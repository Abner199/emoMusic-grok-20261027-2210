[{"t0": 0.0, "t1": 3.6, "text": "当年两个都绑脚"}, {"t0": 3.6, "t1": 7.48, "text": "我对这黑白照片开始想象"}, {"t0": 7.48, "t1": 12.92, "text": "怕干嘛 当年的模样"}, {"t0": 12.92, "t1": 16.6, "text": "说他没一个无奈的爱意的姑娘"}, {"t0": 16.6, "t1": 21.08, "text": "缓缓走过外装"}, {"t0": 21.08, "t1": 25.12, "text": "消失的就是光 依旧是山"}, {"t0": 25.12, "t1": 29.52, "text": "在回忆的路上 时间变高吗"}, {"t0": 29.52, "t1": 30.52, "text": "小姐"}]