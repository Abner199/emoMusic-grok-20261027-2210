[{"t0": 0.0, "t1": 4.6, "text": "你的衣衫破膠 二個身卻溫柔"}, {"t0": 4.6, "t1": 8.6, "text": "陪我滿吻目的的四處漂流"}, {"t0": 8.6, "t1": 13.6, "text": "我的背景如黃球 而你卻揮笑白手"}, {"t0": 13.6, "t1": 17.6, "text": "把他當成整個宇宙"}, {"t0": 17.6, "t1": 21.6, "text": "你與他有揮手 也同還有吻後"}, {"t0": 21.6, "t1": 25.6, "text": "陪我愛天海底的四處風流"}, {"t0": 25.6, "t1": 29.6, "text": "只是遺憾逆中秋 無法躺在我手"}, {"t0": 29.6, "t1": 30.6, "text": "字幕by索兰娅"}]