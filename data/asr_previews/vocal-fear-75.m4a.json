[{"t0": 0.0, "t1": 4.6, "text": "望望身邊 應該有 已盡有"}, {"t0": 4.6, "t1": 11.8, "text": "我的美酒 跑車 相機 禁錶 也講夠"}, {"t0": 11.8, "t1": 15.8, "text": "直到世間 個個也都記"}, {"t0": 15.8, "t1": 19.6, "text": "仍不怎麼富有"}, {"t0": 19.6, "t1": 22.8, "text": "用我上有 換我沒有"}, {"t0": 22.8, "t1": 26.0, "text": "其實已用盡所擁有"}, {"t0": 26.0, "t1": 29.6, "text": "曾付出 幾多心跳"}, {"t0": 29.6, "t1": 30.1, "text": "你.."}]