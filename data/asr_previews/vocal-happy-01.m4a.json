[{"t0": 0.0, "t1": 2.28, "text": "勇敢追自己的夢"}, {"t0": 2.28, "t1": 6.0, "text": "像我堅定的模樣"}, {"t0": 6.0, "t1": 8.0, "text": "是否愛到的笑容"}, {"t0": 8.0, "t1": 10.0, "text": "都沒你的天吧"}, {"t0": 10.0, "t1": 12.0, "text": "月正午的陽光"}, {"t0": 12.0, "t1": 14.0, "text": "都沒你耀眼"}, {"t0": 14.0, "t1": 16.0, "text": "熱愛一百里五度的你"}, {"t0": 16.0, "t1": 20.0, "text": "滴滴青春的全流水"}, {"t0": 20.0, "t1": 22.0, "text": "在這獨一無二"}, {"t0": 22.0, "t1": 24.0, "text": "屬於我的時代"}, {"t0": 24.0, "t1": 26.0, "text": "無法失敗了一場"}, {"t0": 26.0, "t1": 28.0, "text": "痛快的熱愛"}, {"t0": 28.0, "t1": 30.0, "text": "我愛你 別離開我"}]