[{"t0": 0.0, "t1": 5.0, "text": "常常想你說的話 是不是別有用心"}, {"t0": 5.0, "t1": 10.0, "text": "迷你很想相信 卻有人不知懷疑"}, {"t0": 10.0, "t1": 15.0, "text": "在你的心裡 我是否就是唯一"}, {"t0": 15.0, "t1": 19.0, "text": "愛就是用我嘗翻著你"}, {"t0": 19.0, "t1": 24.0, "text": "特別的情話多說一點 像我就多看一眼"}, {"t0": 24.0, "t1": 29.0, "text": "聊些多一點點 浪過能真的看見"}, {"t0": 29.0, "t1": 30.0, "text": "废話 废話"}]