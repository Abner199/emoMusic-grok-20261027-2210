[{"t0": 0.0, "t1": 2.0, "text": "让你再走寻常的路"}, {"t0": 2.0, "t1": 8.0, "text": "我决定扎手你的人生"}, {"t0": 8.0, "t1": 11.0, "text": "当你的时尚不完"}, {"t0": 11.0, "t1": 15.0, "text": "别说你不能"}, {"t0": 15.0, "t1": 18.0, "text": "让我们趁着阳光"}, {"t0": 18.0, "t1": 22.0, "text": "还伤出了心愿的梦魄"}, {"t0": 22.0, "t1": 25.0, "text": "不要怕露出手脑"}, {"t0": 25.0, "t1": 27.0, "text": "留一点痕"}, {"t0": 27.0, "t1": 29.0, "text": "你成了险难"}, {"t0": 29.0, "t1": 30.0, "text": "小明星大跟班"}]