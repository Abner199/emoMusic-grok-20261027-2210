[{"t0": 0.0, "t1": 2.8, "text": "懂得守护爱情"}, {"t0": 2.8, "t1": 6.6, "text": "你在回忆里留下的交影"}, {"t0": 6.6, "t1": 10.4, "text": "是我爱的风景"}, {"t0": 10.4, "t1": 14.12, "text": "我要送你日付我的想念"}, {"t0": 14.12, "t1": 17.88, "text": "寄出代表爱的明星片"}, {"t0": 17.88, "t1": 21.64, "text": "我要送你 日付我的爱恋"}, {"t0": 21.64, "t1": 25.4, "text": "今天真心把世界走偏"}, {"t0": 25.4, "t1": 29.12, "text": "你就是情点 你就是情点"}, {"t0": 29.12, "t1": 30.12, "text": "我都愛你"}]