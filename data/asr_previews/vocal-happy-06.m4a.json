[{"t0": 0.0, "t1": 2.52, "text": "现在的感受"}, {"t0": 2.52, "t1": 6.52, "text": "河边的风在吹着头发"}, {"t0": 6.52, "t1": 9.64, "text": "飘渡紧着你的手"}, {"t0": 9.64, "t1": 12.36, "text": "一整梦你感动"}, {"t0": 12.36, "t1": 16.04, "text": "我想带你回我的外婆家"}, {"t0": 16.04, "t1": 18.84, "text": "一起看着日落"}, {"t0": 18.84, "t1": 22.32, "text": "一直到我们都睡着"}, {"t0": 22.32, "t1": 23.8, "text": "我想就这样"}, {"t0": 23.8, "t1": 27.28, "text": "牵着你的手不放开"}, {"t0": 27.28, "t1": 29.4, "text": "爱能不能够永远"}, {"t0": 29.4, "t1": 30.4, "text": "當作"}]