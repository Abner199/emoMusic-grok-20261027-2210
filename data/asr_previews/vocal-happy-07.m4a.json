[{"t0": 0.0, "t1": 5.0, "text": "我唱著靈環裡面的奶油 流阿流"}, {"t0": 5.0, "t1": 9.0, "text": "聽過的每句話都很可口 又愛又"}, {"t0": 9.0, "t1": 14.0, "text": "那些多餘的話語全被丟過"}, {"t0": 14.0, "t1": 19.0, "text": "你的眼中只有我"}, {"t0": 19.0, "t1": 24.0, "text": "我輕輕的唱一口 你說的愛我"}, {"t0": 24.0, "t1": 28.0, "text": "還在回味你給過的溫柔"}, {"t0": 28.0, "t1": 30.0, "text": "我靜靜地掌握"}]