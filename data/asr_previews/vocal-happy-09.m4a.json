[{"t0": 0.0, "t1": 4.0, "text": "哼 哼 你說你有點難追"}, {"t0": 4.0, "t1": 7.0, "text": "想讓我真難而退"}, {"t0": 7.0, "t1": 9.0, "text": "理不不虛調最貴"}, {"t0": 9.0, "t1": 12.0, "text": "只要相信的落葉"}, {"t0": 12.0, "t1": 15.0, "text": "隱藏浪漫的餘味"}, {"t0": 15.0, "t1": 17.0, "text": "不害怕高在一切"}, {"t0": 17.0, "t1": 22.0, "text": "擁有你就擁有全世界"}, {"t0": 22.0, "t1": 26.0, "text": "親愛的愛上你"}, {"t0": 26.0, "t1": 29.0, "text": "從那天起"}, {"t0": 29.0, "t1": 30.0, "text": "見"}]