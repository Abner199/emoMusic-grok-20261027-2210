[{"t0": 0.0, "t1": 4.88, "text": "不化療 又變化療"}, {"t0": 4.88, "t1": 7.76, "text": "悄悄我強姦嗎"}, {"t0": 7.76, "t1": 10.08, "text": "是你最美的記號"}, {"t0": 10.08, "t1": 13.12, "text": "我每天睡不著"}, {"t0": 13.12, "t1": 16.0, "text": "想念你的微笑"}, {"t0": 16.0, "t1": 20.8, "text": "你不知道你對我多麼重要"}, {"t0": 20.8, "t1": 25.12, "text": "有了你生命完整的感昊"}, {"t0": 25.12, "t1": 28.0, "text": "悄悅我強姊嗎"}, {"t0": 28.0, "t1": 30.0, "text": "每一人的舞科就要"}]