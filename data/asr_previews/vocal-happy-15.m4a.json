[{"t0": 0.0, "t1": 3.0, "text": "爱你永远不离不弃"}, {"t0": 3.0, "t1": 6.8, "text": "你是我的小鸭小苹果"}, {"t0": 6.8, "t1": 10.2, "text": "怎么爱你都不嫌多"}, {"t0": 10.2, "t1": 12.6, "text": "红红的小点温暖"}, {"t0": 12.6, "t1": 17.0, "text": "我的心我变亮我生命的火"}, {"t0": 17.0, "t1": 18.4, "text": "火火火火"}, {"t0": 18.4, "t1": 22.2, "text": "你是我的 小鸭 小苹果"}, {"t0": 22.2, "t1": 25.6, "text": "就像偏偏最美的云朵"}, {"t0": 25.6, "t1": 28.0, "text": "春天又来到辽华"}, {"t0": 28.0, "t1": 29.6, "text": "开满山坡"}, {"t0": 29.6, "t1": 30.6, "text": "小明星大跟班下次再見"}]