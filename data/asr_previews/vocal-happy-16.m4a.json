[{"t0": 0.0, "t1": 3.4, "text": "願你此刻可回恥"}, {"t0": 3.4, "t1": 7.4, "text": "是我重新的說聲"}, {"t0": 8.4, "t1": 11.4, "text": "喜歡你"}, {"t0": 11.4, "t1": 14.4, "text": "那雙眼動人"}, {"t0": 14.4, "t1": 17.4, "text": "笑聲跟迷人"}, {"t0": 17.4, "t1": 20.6, "text": "願再好"}, {"t0": 20.6, "t1": 23.6, "text": "輕撫你"}, {"t0": 23.6, "t1": 26.6, "text": "那好愛免用"}, {"t0": 26.6, "t1": 29.6, "text": "玩小薰夢吧"}]