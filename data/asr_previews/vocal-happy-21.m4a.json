[{"t0": 0.0, "t1": 4.2, "text": "傷心的都忘記了"}, {"t0": 4.2, "t1": 8.2, "text": "只記得這首相望的"}, {"t0": 8.2, "t1": 12.4, "text": "那一點天空很高 風很輕鬆"}, {"t0": 12.4, "t1": 15.8, "text": "從頭到腳 直到快樂"}, {"t0": 15.8, "t1": 20.2, "text": "我和你都約好了"}, {"t0": 20.2, "t1": 24.2, "text": "要再唱這首相往的歌"}, {"t0": 24.2, "t1": 28.4, "text": "這一生只願 只要平凡快樂"}, {"t0": 28.4, "t1": 30.4, "text": "生存的樣子"}]