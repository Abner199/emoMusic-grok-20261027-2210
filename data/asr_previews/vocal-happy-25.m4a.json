[{"t0": 0.0, "t1": 2.0, "text": "寄出真心上"}, {"t0": 2.0, "t1": 5.0, "text": "你微笑流浪"}, {"t0": 5.0, "t1": 8.0, "text": "手机里的浪漫"}, {"t0": 8.0, "t1": 10.0, "text": "原来真心上"}, {"t0": 10.0, "t1": 13.0, "text": "就算是这么简单"}, {"t0": 13.0, "t1": 16.0, "text": "本心引不上"}, {"t0": 16.0, "t1": 19.0, "text": "你可爱的模样"}, {"t0": 19.0, "t1": 22.0, "text": "快乐缘分的节奏"}, {"t0": 22.0, "t1": 25.0, "text": "我又多转了一行"}, {"t0": 25.0, "t1": 28.0, "text": "你微笑浪浪"}, {"t0": 28.0, "t1": 30.0, "text": "心裡的溫柔"}]