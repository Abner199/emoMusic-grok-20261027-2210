[{"t0": 0.0, "t1": 3.0, "text": "做我的耿诺翅膀"}, {"t0": 3.0, "t1": 5.0, "text": "让我飞"}, {"t0": 5.0, "t1": 9.0, "text": "也有回去的我"}, {"t0": 9.0, "t1": 11.0, "text": "我愿意"}, {"t0": 11.0, "t1": 15.0, "text": "我也可以"}, {"t0": 15.0, "t1": 20.0, "text": "付出一切也不会可惜"}, {"t0": 20.0, "t1": 24.0, "text": "明明就在一起"}, {"t0": 24.0, "t1": 28.0, "text": "看世界流逝"}, {"t0": 28.0, "t1": 30.0, "text": "要记得我们"}]