[{"t0": 0.0, "t1": 6.0, "text": "永恢复现在眼前"}, {"t0": 6.0, "t1": 8.5, "text": "蓝色的思念"}, {"t0": 8.5, "t1": 12.5, "text": "突然变成了阳光的夏天"}, {"t0": 12.5, "t1": 14.0, "text": "空气中的温暖"}, {"t0": 14.0, "t1": 18.5, "text": "不会更遥远后冬天"}, {"t0": 18.5, "t1": 22.0, "text": "夜风不再流连"}, {"t0": 22.0, "t1": 24.0, "text": "黑色的思眠"}, {"t0": 24.0, "t1": 26.0, "text": "挥手对我说一声"}, {"t0": 26.0, "t1": 28.0, "text": "自己不变"}, {"t0": 28.0, "t1": 29.5, "text": "不过一季的时间"}]