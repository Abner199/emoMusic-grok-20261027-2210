[{"t0": 0.0, "t1": 4.8, "text": "想像人意改变"}, {"t0": 4.8, "t1": 9.6, "text": "长进两个人一起散着步"}, {"t0": 9.6, "t1": 14.0, "text": "我的脸也轻轻贴着你胸口"}, {"t0": 14.0, "t1": 16.36, "text": "遇到心跳"}, {"t0": 16.36, "t1": 22.28, "text": "在乎我和天气一样温度"}, {"t0": 22.28, "t1": 26.64, "text": "夏天的风我永远记得"}, {"t0": 26.64, "t1": 29.96, "text": "清清楚楚的说你爱我"}]