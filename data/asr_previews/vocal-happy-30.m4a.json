[{"t0": 0.0, "t1": 4.68, "text": "想像人已改变"}, {"t0": 4.68, "t1": 9.48, "text": "场景两个人一起散着步"}, {"t0": 9.48, "t1": 13.96, "text": "我的脸也轻轻贴着你胸口"}, {"t0": 13.96, "t1": 16.32, "text": "遇到心跳"}, {"t0": 16.32, "t1": 22.24, "text": "在乎我和天气一样温度"}, {"t0": 22.24, "t1": 26.52, "text": "夏天的风微又延期的"}, {"t0": 26.52, "t1": 29.96, "text": "清清楚楚的说你爱我"}]