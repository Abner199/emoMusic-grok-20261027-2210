[{"t0": 0.0, "t1": 1.48, "text": "我们可以无助黑色幽默"}, {"t0": 1.48, "t1": 5.56, "text": "忘了你存在 有什么期待"}, {"t0": 5.56, "t1": 9.4, "text": "忘了你呀 请他一一来"}, {"t0": 9.4, "t1": 13.2, "text": "一起跟王冠冠 不如一起精彩"}, {"t0": 13.2, "t1": 16.32, "text": "快乐回转任 请你放开"}, {"t0": 16.32, "t1": 17.04, "text": "Come on"}, {"t0": 17.04, "t1": 20.84, "text": "想念的失恋的请跟我来"}, {"t0": 20.84, "t1": 24.76, "text": "一边跳一边想快乐崇拜"}, {"t0": 24.76, "t1": 28.56, "text": "开心不开心的都跟我来"}, {"t0": 28.56, "t1": 29.96, "text": "咪咪而生"}]