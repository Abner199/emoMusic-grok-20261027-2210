[{"t0": 0.0, "t1": 5.24, "text": "我也不知为何 伤口还没愈合"}, {"t0": 5.24, "t1": 9.44, "text": "你就这样闯进我的心窝"}, {"t0": 9.44, "t1": 12.12, "text": "是你让我看见刚哭下"}, {"t0": 12.12, "t1": 14.04, "text": "我开出话一朵"}, {"t0": 14.04, "t1": 16.44, "text": "是你让我想的你听"}, {"t0": 16.44, "t1": 18.68, "text": "为你写一首情歌"}, {"t0": 18.68, "t1": 21.0, "text": "有最浪漫的符合"}, {"t0": 21.0, "t1": 23.6, "text": "你也轻轻的符号"}, {"t0": 23.6, "t1": 27.84, "text": "眼前揭秘着我们的选择"}, {"t0": 27.84, "t1": 29.88, "text": "是你让我的世界"}, {"t0": 29.88, "t1": 31.88, "text": "字幕by索兰娅"}]