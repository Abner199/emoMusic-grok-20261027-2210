[{"t0": 0.0, "t1": 6.0, "text": "第一次遇見陰天 遮住你側臉"}, {"t0": 6.0, "t1": 10.0, "text": "有什麼故事 好想了解"}, {"t0": 10.0, "t1": 16.0, "text": "我感覺我懂 你的特別"}, {"t0": 16.0, "t1": 20.0, "text": "你的信用一刀槍"}, {"t0": 20.0, "t1": 25.0, "text": "但我發現一扇窗"}, {"t0": 25.0, "t1": 29.0, "text": "偶爾偷出一絲暖暖的"}, {"t0": 29.0, "t1": 30.0, "text": "軟軟的"}]