[{"t0": 0.0, "t1": 4.0, "text": "只顾了宿舍驕傲 已走过人间危险"}, {"t0": 4.0, "t1": 11.0, "text": "不成立场悄伤 人如海车乘航"}, {"t0": 11.0, "t1": 17.0, "text": "你笑得像光芒 默认把我照亮"}, {"t0": 17.0, "t1": 20.0, "text": "不像像光芛 不认吧我照亮"}, {"t0": 20.0, "t1": 28.0, "text": "风轻扬下微阳 另一路但却像"}, {"t0": 28.0, "t1": 30.0, "text": "原來是 詞曲 李宗盛"}]