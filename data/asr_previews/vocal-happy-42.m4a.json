[{"t0": 0.0, "t1": 6.6, "text": "雙懷的天氣 向你心慘則不定"}, {"t0": 6.6, "t1": 14.0, "text": "如果這是結局 我希望你 時生的滿意"}, {"t0": 14.0, "t1": 16.0, "text": "希望你能見到我"}, {"t0": 16.0, "t1": 19.4, "text": "你 就是我的小星星"}, {"t0": 19.4, "t1": 23.8, "text": "光 在那邊上 反光影我意"}, {"t0": 23.8, "t1": 29.0, "text": "請決定要愛你 就不會輕易放棄"}, {"t0": 29.0, "t1": 30.0, "text": "Zither Harp"}]