[{"t0": 0.0, "t1": 3.12, "text": "你记得每分每秒"}, {"t0": 3.12, "t1": 5.28, "text": "你对我多重要"}, {"t0": 5.28, "t1": 7.92, "text": "我想你比我更知道"}, {"t0": 7.92, "t1": 12.92, "text": "你就是我的女主角"}, {"t0": 12.92, "t1": 15.76, "text": "有时候我懒得像只猫"}, {"t0": 15.76, "t1": 19.92, "text": "脾气不好是有张牙舞掌"}, {"t0": 19.92, "t1": 21.96, "text": "你总是温柔的"}, {"t0": 21.96, "t1": 24.6, "text": "能把我的心融化掉"}, {"t0": 24.6, "t1": 29.08, "text": "就想要等你的小冒冒"}]