[{"t0": 0.0, "t1": 2.0, "text": "灼烈的颜色"}, {"t0": 2.0, "t1": 5.0, "text": "我牵着你的手经过"}, {"t0": 5.0, "t1": 8.0, "text": "种满雅荡的山沫"}, {"t0": 8.0, "t1": 9.0, "text": "闪光的拥护"}, {"t0": 9.0, "t1": 10.0, "text": "明天将会热"}, {"t0": 10.0, "t1": 12.0, "text": "冻进在我的耳朵"}, {"t0": 12.0, "t1": 15.0, "text": "在下买一档手头"}, {"t0": 15.0, "t1": 17.0, "text": "我醒来的笑着"}, {"t0": 17.0, "t1": 20.0, "text": "开心的对面说"}, {"t0": 20.0, "t1": 22.0, "text": "我满嘴都是烫护"}, {"t0": 22.0, "t1": 25.0, "text": "牵着你手经过"}, {"t0": 25.0, "t1": 28.0, "text": "种满亚荡的沙漠"}, {"t0": 28.0, "t1": 30.0, "text": "我的心痛不快"}]