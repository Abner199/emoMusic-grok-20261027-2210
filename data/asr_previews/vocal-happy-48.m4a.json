[{"t0": 0.0, "t1": 4.2, "text": "明明就不習慣掙手"}, {"t0": 4.2, "t1": 8.4, "text": "為何卻主動把手勾"}, {"t0": 8.4, "t1": 12.0, "text": "但你的心事太多"}, {"t0": 12.0, "t1": 17.0, "text": "我不會錯過"}, {"t0": 17.0, "t1": 21.0, "text": "明明就大筆小溫柔"}, {"t0": 21.0, "t1": 26.4, "text": "也許讓能給你更多"}, {"t0": 26.4, "t1": 29.9, "text": "不用覺得我會自信"}, {"t0": 29.9, "t1": 31.9, "text": "字幕by索兰娅"}]