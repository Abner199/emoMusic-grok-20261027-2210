[{"t0": 0.0, "t1": 3.68, "text": "千万不要说 天长地久"}, {"t0": 3.68, "t1": 7.28, "text": "念的你觉得 我孤独且洗净"}, {"t0": 7.28, "t1": 11.4, "text": "想多么简单 就多么箺单"}, {"t0": 11.4, "t1": 14.4, "text": "是妈妈告诉我的这里"}, {"t0": 14.4, "t1": 18.0, "text": "脑袋都是你 心里都是你"}, {"t0": 18.0, "t1": 21.64, "text": "小小的爱 在它城里好甜蜜"}, {"t0": 21.64, "t1": 25.28, "text": "念的都是你 全部都是你"}, {"t0": 25.28, "t1": 29.84, "text": "小小的愛 在它城裡只为你清醒"}]