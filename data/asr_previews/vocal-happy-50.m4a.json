[{"t0": 0.0, "t1": 2.0, "text": "只要你在我身边"}, {"t0": 2.0, "t1": 5.0, "text": "所有非留言我真实而不见"}, {"t0": 5.0, "t1": 7.0, "text": "请不要匆匆一遍"}, {"t0": 7.0, "t1": 13.0, "text": "你转身就沉入海平险"}, {"t0": 13.0, "t1": 18.0, "text": "传说中你为爱甘心为隔天"}, {"t0": 18.0, "t1": 23.0, "text": "我也可以为你写入海里面"}, {"t0": 23.0, "t1": 25.0, "text": "怎么任性恨绝"}, {"t0": 25.0, "t1": 29.0, "text": "忘记我不变的誓言"}, {"t0": 29.0, "t1": 31.0, "text": "我依蜜"}]