[{"t0": 0.0, "t1": 5.36, "text": "看静阳光离晒干回忆"}, {"t0": 5.36, "t1": 12.8, "text": "只好了伤心明天切只和快乐出去"}, {"t0": 12.8, "t1": 16.2, "text": "这爱的城市虽然拥挤"}, {"t0": 16.2, "t1": 20.0, "text": "如果真的遇见你"}, {"t0": 20.0, "t1": 21.8, "text": "你不必压抑"}, {"t0": 21.8, "t1": 27.44, "text": "我的小套无法代替"}, {"t0": 27.44, "t1": 29.68, "text": "离开你我才发现"}, {"t0": 29.68, "t1": 31.68, "text": "字幕by索兰娅"}]