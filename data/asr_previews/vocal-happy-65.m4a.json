[{"t0": 0.0, "t1": 4.0, "text": "等你的眼睛閉著笑"}, {"t0": 4.0, "t1": 8.0, "text": "等你喝可樂 等你吵"}, {"t0": 8.0, "t1": 12.0, "text": "我想對你後 你從來不知道"}, {"t0": 12.0, "t1": 15.0, "text": "想你 想你 也能成為時後"}, {"t0": 15.0, "t1": 18.0, "text": "等你說今天的煩惱"}, {"t0": 18.0, "t1": 22.0, "text": "等你說夜深 你睡不著"}, {"t0": 22.0, "t1": 26.0, "text": "我想對你說 卻害怕都說錯"}, {"t0": 26.0, "t1": 28.0, "text": "好喜歡你"}, {"t0": 28.0, "t1": 30.0, "text": "你知不"}]