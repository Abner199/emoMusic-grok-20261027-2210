[{"t0": 0.0, "t1": 2.0, "text": " I'm friends and this, I'm home"}, {"t0": 2.0, "t1": 4.0, "text": " That's right, darling"}, {"t0": 4.0, "t1": 6.0, "text": " You're the one I want"}, {"t0": 6.0, "t1": 8.0, "text": " Paper rings"}, {"t0": 8.0, "t1": 10.0, "text": " In picture frames"}, {"t0": 10.0, "t1": 12.0, "text": " In dirty dreams"}, {"t0": 12.0, "t1": 14.0, "text": " Oh, you're the one"}, {"t0": 14.0, "t1": 16.0, "text": " I want"}, {"t0": 16.0, "t1": 18.0, "text": " In the winter, in the icy outdoor pool"}, {"t0": 18.0, "t1": 20.0, "text": " When you jumped in first, I went into"}, {"t0": 20.0, "t1": 22.0, "text": " I'm with you, even if it makes me blue"}, {"t0": 22.0, "t1": 24.0, "text": " Which takes me back"}, {"t0": 24.0, "t1": 26.0, "text": " To the color that we painted"}, {"t0": 26.0, "t1": 28.0, "text": " Your brother's wall, honey"}, {"t0": 28.0, "t1": 30.0, "text": " X fights and flaws, we wouldn't..."}]