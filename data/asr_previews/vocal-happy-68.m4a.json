[{"t0": 0.0, "t1": 4.0, "text": "她的肩膀彎了嘴角"}, {"t0": 4.0, "t1": 7.0, "text": "不必盡快對我笑"}, {"t0": 7.0, "t1": 10.0, "text": "沒有遇到就不遺憾"}, {"t0": 10.0, "t1": 13.0, "text": "聽人嫌對我是好"}, {"t0": 13.0, "t1": 17.0, "text": "她的肌膀我彎了吹嘲"}, {"t0": 17.0, "t1": 20.0, "text": "用電聲給我拍照"}, {"t0": 20.0, "t1": 23.0, "text": "我解不掉她的微笑"}, {"t0": 23.0, "t1": 26.0, "text": "表演幸福的回憶"}, {"t0": 26.0, "t1": 29.0, "text": "有些人是沒辦法照"}, {"t0": 29.0, "t1": 29.9, "text": "加油"}]