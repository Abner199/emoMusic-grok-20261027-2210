[{"t0": 0.0, "t1": 3.74, "text": "三圈在地跑蜿蜒"}, {"t0": 3.74, "t1": 5.58, "text": "今晚就很久以前"}, {"t0": 5.58, "t1": 7.36, "text": "我要一張自己的臉"}, {"t0": 7.36, "t1": 9.42, "text": "全身多盡狂沉淹"}, {"t0": 9.42, "t1": 11.02, "text": "夜夜在匆匆的掌握"}, {"t0": 11.02, "t1": 12.34, "text": "數秒在上面"}, {"t0": 12.34, "t1": 13.66, "text": "我記得那年"}, {"t0": 13.66, "t1": 15.14, "text": "在一個雨天"}, {"t0": 15.14, "t1": 17.26, "text": "那起水頭我躲在屋簷"}, {"t0": 17.26, "t1": 19.34, "text": "就一直想去當秋千"}, {"t0": 19.34, "t1": 20.74, "text": "夜夜坐著岩"}, {"t0": 20.74, "t1": 22.34, "text": "手躺著陸一些茶前"}, {"t0": 22.34, "t1": 24.18, "text": "三圈都穿了千年"}, {"t0": 24.18, "t1": 26.18, "text": "那天不翻月子天"}, {"t0": 26.18, "t1": 27.62, "text": "在山馬車眼"}, {"t0": 27.62, "t1": 29.98, "text": "希望一切都像個難的願望"}]