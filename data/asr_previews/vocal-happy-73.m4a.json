[{"t0": 0.0, "t1": 4.24, "text": "外 總是被打敗"}, {"t0": 4.24, "t1": 7.72, "text": "真的好無奈"}, {"t0": 7.72, "t1": 10.0, "text": "其實我實實才猜"}, {"t0": 10.0, "t1": 14.0, "text": "不管帥不帥"}, {"t0": 14.0, "t1": 17.0, "text": "想要找回來"}, {"t0": 17.0, "t1": 20.0, "text": "自己的解敗"}, {"t0": 20.0, "t1": 22.0, "text": "所以這一次"}, {"t0": 22.0, "t1": 28.0, "text": "我要勇敢大聲說出來"}, {"t0": 28.0, "t1": 29.0, "text": "期待"}, {"t0": 29.0, "t1": 31.0, "text": "詞曲 李宗盛"}]