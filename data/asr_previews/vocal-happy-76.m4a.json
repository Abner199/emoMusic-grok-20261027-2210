[{"t0": 0.0, "t1": 6.0, "text": "没什么苹果和拥抱都可能是毒药"}, {"t0": 6.0, "t1": 11.0, "text": "都从没想过有了它还孤单的可怕"}, {"t0": 11.0, "t1": 16.0, "text": "我突然想起从前被我那个仰望"}, {"t0": 16.0, "t1": 19.0, "text": "我不想我不想不想长大"}, {"t0": 19.0, "t1": 21.0, "text": "长大后世界就没等华"}, {"t0": 21.0, "t1": 24.0, "text": "我不想我不想不想長大"}, {"t0": 24.0, "t1": 26.0, "text": "我宁愿永远都被扬下"}, {"t0": 26.0, "t1": 29.0, "text": "我不想我不不想不像长大"}, {"t0": 29.0, "t1": 30.0, "text": "但就 not"}]