[{"t0": 0.0, "t1": 6.0, "text": "是掙扎的自由"}, {"t0": 6.0, "t1": 10.0, "text": "分辨 总是在久远"}, {"t0": 10.0, "t1": 14.0, "text": "回忆是思念的愁"}, {"t0": 14.0, "t1": 18.0, "text": "深秋 能履得吹流"}, {"t0": 18.0, "t1": 22.0, "text": "牵绊住我河头"}, {"t0": 22.0, "t1": 26.0, "text": "在那座阴雨底下沉溺"}, {"t0": 26.0, "t1": 29.0, "text": "我从没忘记你"}]