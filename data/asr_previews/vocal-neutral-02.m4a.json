[{"t0": 0.0, "t1": 6.0, "text": "苏卑勾勒 初情花 被风浓转淡"}, {"t0": 6.0, "t1": 10.0, "text": "凭真妙回的木灯 已如你出装"}, {"t0": 10.0, "t1": 15.0, "text": "蓝蓝弹枪 度过窗 心事莫了然"}, {"t0": 15.0, "t1": 19.0, "text": "选之上 走比至此各一般"}, {"t0": 19.0, "t1": 23.0, "text": "有色渲染 是你图 因为别自藏"}, {"t0": 23.0, "t1": 28.0, "text": "若你依然的一笑 如汉堡太方"}, {"t0": 28.0, "t1": 30.0, "text": "你的每一禮票"}]