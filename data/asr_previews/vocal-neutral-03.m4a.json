[{"t0": 0.0, "t1": 2.0, "text": "捡着一斤毛泳"}, {"t0": 2.0, "t1": 7.0, "text": "听妈妈的话"}, {"t0": 7.0, "t1": 12.0, "text": "别让她受伤"}, {"t0": 12.0, "t1": 17.0, "text": "像乖乖长大"}, {"t0": 17.0, "t1": 22.0, "text": "才能保护她"}, {"t0": 22.0, "t1": 27.0, "text": "迷离的白发"}, {"t0": 27.0, "t1": 30.0, "text": "幸福's over"}]