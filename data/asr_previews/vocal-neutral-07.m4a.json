[{"t0": 0.0, "t1": 4.56, "text": "还记得你说这是为了长暴"}, {"t0": 4.56, "t1": 7.6, "text": "睡着到想得要继续暗暴"}, {"t0": 7.6, "t1": 11.24, "text": "没有微笑 像是狗的梦我知道"}, {"t0": 11.24, "t1": 12.96, "text": "像是狼的梦 我知道"}, {"t0": 12.96, "t1": 16.28, "text": "不要固然阴魂重带着你淌暴"}, {"t0": 16.28, "t1": 19.28, "text": "像见到个遥远的依靠"}, {"t0": 19.28, "t1": 23.04, "text": "回家吧 回到最初的美好"}, {"t0": 23.04, "t1": 25.04, "text": "Why don't you just don't let me out"}]