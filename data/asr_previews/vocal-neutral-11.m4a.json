[{"t0": 0.0, "t1": 4.0, "text": "老师们都一想不起"}, {"t0": 4.0, "t1": 7.0, "text": "猜不出问题的你"}, {"t0": 7.0, "t1": 11.0, "text": "我也是偶然翻相片"}, {"t0": 11.0, "t1": 14.0, "text": "才想起痛惹的你"}, {"t0": 14.0, "t1": 18.0, "text": "谁去了多吵伤感的你"}, {"t0": 18.0, "t1": 22.0, "text": "谁看了你的日记"}, {"t0": 22.0, "t1": 26.0, "text": "谁把你的长发抛弃"}, {"t0": 26.0, "t1": 29.0, "text": "谁给你做的假意"}]