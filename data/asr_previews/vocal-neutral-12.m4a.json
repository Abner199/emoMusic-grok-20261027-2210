[{"t0": 0.0, "t1": 6.0, "text": "喝了几大碗米就在离开"}, {"t0": 6.0, "t1": 11.0, "text": "是为了模仿"}, {"t0": 11.0, "t1": 14.0, "text": "一出门不小心吐的那副"}, {"t0": 14.0, "t1": 19.0, "text": "是谁的舒黄"}, {"t0": 19.0, "t1": 23.0, "text": "你一天一靠一个亲爱的对方"}, {"t0": 23.0, "t1": 27.0, "text": "多么不流行的模样"}, {"t0": 27.0, "t1": 30.0, "text": "都应该连连书发责"}]