[{"t0": 0.0, "t1": 4.0, "text": "未来 像一环境接离"}, {"t0": 4.0, "t1": 8.0, "text": "未结果的爱 浓藏了每一夜时"}, {"t0": 8.0, "t1": 11.0, "text": "闻醉腾腾的告白"}, {"t0": 11.0, "t1": 14.0, "text": "而风声吹到这儿一步需要"}, {"t0": 14.0, "t1": 18.0, "text": "是怀疑就老去吧"}, {"t0": 18.0, "t1": 22.0, "text": "孤独别醒来"}, {"t0": 22.0, "t1": 26.0, "text": "你渴望的离开"}, {"t0": 26.0, "t1": 30.0, "text": "只是无处停门"}]