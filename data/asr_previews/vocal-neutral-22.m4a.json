[{"t0": 0.0, "t1": 5.24, "text": "嗚嗚不流浪 千里回忆"}, {"t0": 5.24, "t1": 8.6, "text": "生命已浪 别忘情别"}, {"t0": 8.6, "t1": 11.72, "text": "今次空间 怎样也无畏"}, {"t0": 11.72, "t1": 14.88, "text": "好往后去 能与生相留情"}, {"t0": 14.88, "t1": 18.0, "text": "嗚不浪 回忆 万里违离"}, {"t0": 18.0, "t1": 21.2, "text": "生命已 浪 別忘情别"}, {"t0": 21.2, "t1": 24.32, "text": "今次空間 怎样已无畏"}, {"t0": 24.32, "t1": 26.0, "text": "不曾避伤 别好情别"}, {"t0": 26.0, "t1": 30.0, "text": "彈指歲月 琴唱琴歌琴歌"}]