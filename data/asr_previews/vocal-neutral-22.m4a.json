[{"t0": 0.0, "t1": 5.0, "text": "不妨碰天外 街道迷迷 回忆"}, {"t0": 5.0, "t1": 8.0, "text": "生命一夜 难免千年"}, {"t0": 8.0, "t1": 11.0, "text": "心曾痛苦 街道纵横 变得无怀"}, {"t0": 11.0, "t1": 14.0, "text": "傲然的距离 难以承诺了结"}, {"t0": 14.0, "t1": 17.0, "text": "不妨疯狂 街道遥遥 迷遥"}, {"t0": 17.0, "t1": 20.0, "text": "生命一月 难遍千年"}, {"t0": 20.0, "t1": 24.0, "text": "心曾痛哭 街道紫阳 悲痛无怀"}, {"t0": 24.0, "t1": 26.0, "text": "不准闭上瞄几眼"}, {"t0": 26.0, "t1": 29.0, "text": "叹此岁月 轻声轻歌轻歌"}, {"t0": 29.0, "t1": 30.0, "text": "分隔几年"}]