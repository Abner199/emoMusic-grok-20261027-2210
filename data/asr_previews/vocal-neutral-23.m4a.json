[{"t0": 0.0, "t1": 2.44, "text": "我的要求我找不到"}, {"t0": 2.44, "t1": 4.96, "text": "放在糖果旁边"}, {"t0": 4.96, "t1": 9.88, "text": "是我更想为你的甜"}, {"t0": 9.88, "t1": 17.2, "text": "燃热我预论你和我沦落的枕枚"}, {"t0": 17.2, "t1": 20.48, "text": "存在盒子里的生地"}, {"t0": 20.48, "t1": 24.6, "text": "给我的快乐"}, {"t0": 24.6, "t1": 26.8, "text": "我更想记得"}, {"t0": 26.8, "t1": 29.68, "text": "可是我记不得"}]