[{"t0": 0.0, "t1": 4.0, "text": "眼睛也要擦亮 戒指我的模樣"}, {"t0": 4.0, "t1": 7.0, "text": "表情不用太緊張 我是三年二百"}, {"t0": 7.0, "t1": 9.0, "text": "我轉型單球的側臉還蠻好看"}, {"t0": 9.0, "t1": 11.0, "text": "黑白是洗手指數的地方"}, {"t0": 11.0, "t1": 13.0, "text": "只是角色的陽光 蠻眼神我不太喜歡"}, {"t0": 13.0, "t1": 16.0, "text": "沒有操場的自然 會更比較漂亮"}, {"t0": 16.0, "t1": 19.0, "text": "我的都是在隔壁 版還有考卷的答案"}, {"t0": 19.0, "t1": 21.0, "text": "我剛好都不會算 沒關係"}, {"t0": 21.0, "t1": 23.0, "text": "再繼續努力 沒關係"}, {"t0": 23.0, "t1": 25.0, "text": "為什麼 上的事 舉手的囊"}, {"t0": 25.0, "t1": 28.0, "text": "為什麼 那些傷 保護子彈"}, {"t0": 28.0, "t1": 30.0, "text": "我愛什麼 悲傷不釋"}]