[{"t0": 0.0, "t1": 3.0, "text": "也曾一起想"}, {"t0": 3.0, "t1": 8.0, "text": "有个地方睡觉吃饭"}, {"t0": 8.0, "t1": 12.0, "text": "可曾吗只有日夜颠倒"}, {"t0": 12.0, "t1": 16.0, "text": "脸头捆 也凑不到"}, {"t0": 16.0, "t1": 22.0, "text": "墙板被我砸烂到现在还没修"}, {"t0": 22.0, "t1": 26.0, "text": "一碗热的酒 你怕我没够"}, {"t0": 26.0, "t1": 29.0, "text": "都留一半带走"}, {"t0": 29.0, "t1": 30.0, "text": "Go go go"}]