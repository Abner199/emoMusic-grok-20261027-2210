[{"t0": 0.0, "t1": 2.0, "text": "不知道不明亮"}, {"t0": 2.0, "t1": 7.0, "text": "我想要為什麼我的心"}, {"t0": 7.0, "t1": 11.0, "text": "明明是想靠近"}, {"t0": 11.0, "t1": 14.0, "text": "卻孤單的黎明"}, {"t0": 14.0, "t1": 16.0, "text": "不知道不明了"}, {"t0": 16.0, "t1": 21.0, "text": "為什麼我的心"}, {"t0": 21.0, "t1": 25.0, "text": "那愛情的記憶"}, {"t0": 25.0, "t1": 28.0, "text": "總是在孤單裡"}, {"t0": 28.0, "t1": 30.0, "text": "Zither Harp"}]