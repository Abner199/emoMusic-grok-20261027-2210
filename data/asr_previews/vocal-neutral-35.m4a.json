[{"t0": 0.0, "t1": 6.0, "text": "空空留意很多难堪又为难"}, {"t0": 6.0, "t1": 11.7, "text": "虽然荣兰惊欢 时间风干喉"}, {"t0": 11.7, "t1": 14.9, "text": "你我再无关"}, {"t0": 14.9, "t1": 22.9, "text": "没答案怎么办 看不惯自我起码"}, {"t0": 22.9, "t1": 26.3, "text": "纵容着喜欢的讨厌的"}, {"t0": 26.3, "t1": 29.9, "text": "冲你的眼圈的一个个忙"}, {"t0": 29.9, "t1": 31.9, "text": "字幕by索兰娅"}]