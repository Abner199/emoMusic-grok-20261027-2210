[{"t0": 0.0, "t1": 4.0, "text": "梦想总是要不可及"}, {"t0": 4.0, "t1": 7.0, "text": "是不是应该放弃"}, {"t0": 7.0, "t1": 11.0, "text": "花开花落又是一季"}, {"t0": 11.0, "t1": 15.0, "text": "春天啊你在哪里"}, {"t0": 19.0, "t1": 23.0, "text": "青春如同奔流的江河"}, {"t0": 23.0, "t1": 26.0, "text": "你却不会来不及道别"}, {"t0": 26.0, "t1": 29.0, "text": "只剩下麻木的我没有"}]