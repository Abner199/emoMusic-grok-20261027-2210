[{"t0": 0.0, "t1": 3.72, "text": "遇到了这里沉沉陷"}, {"t0": 3.72, "t1": 8.2, "text": "缠着我们榴莲人世间"}, {"t0": 8.2, "t1": 11.68, "text": "你在身边就是缘"}, {"t0": 11.68, "t1": 16.24, "text": "缘分写在三圣史上面"}, {"t0": 16.24, "t1": 19.68, "text": "爱有万分之一天"}, {"t0": 19.68, "t1": 24.2, "text": "宁愿我就藏在这一天"}, {"t0": 24.2, "t1": 26.0, "text": "圈圈月月圈月"}, {"t0": 26.0, "t1": 28.72, "text": "天天年年天天的我"}, {"t0": 28.72, "t1": 30.72, "text": "我只能跟你"}]