[{"t0": 0.0, "t1": 4.0, "text": "人人不得 需要"}, {"t0": 4.0, "t1": 9.4, "text": "曾经在摸索的人"}, {"t0": 9.4, "t1": 14.4, "text": "和他们关心的"}, {"t0": 14.4, "t1": 21.0, "text": "的地方 和那些错过的"}, {"t0": 21.0, "t1": 25.4, "text": "清晨一顿"}, {"t0": 25.4, "t1": 28.8, "text": "某位努力浇了水"}, {"t0": 28.8, "t1": 29.98, "text": "嘿嘿 美好"}]