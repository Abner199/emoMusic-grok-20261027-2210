[{"t0": 0.0, "t1": 6.2, "text": "消息 思念持续成农云"}, {"t0": 6.2, "t1": 11.48, "text": "梦敢添下去 誓言继续"}, {"t0": 11.48, "t1": 16.84, "text": "陪你累计所有回忆"}, {"t0": 16.84, "t1": 20.4, "text": "暖声的是热炸"}, {"t0": 20.4, "t1": 24.0, "text": "暖心的是你一句话"}, {"t0": 24.0, "t1": 26.4, "text": "许给你一个假"}, {"t0": 26.4, "t1": 30.0, "text": "却微笑我的牵挂"}]