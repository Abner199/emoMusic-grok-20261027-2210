[{"t0": 0.0, "t1": 6.56, "text": "想起了你 再想到自己"}, {"t0": 6.56, "t1": 12.16, "text": "我為什麼總在非常脆弱的時候"}, {"t0": 12.16, "t1": 15.76, "text": "懷念你"}, {"t0": 15.76, "t1": 20.8, "text": "我明白 太放不開你的愛"}, {"t0": 20.8, "t1": 26.0, "text": "太熟悉你的關懷 分不開"}, {"t0": 26.0, "t1": 29.6, "text": "像你算治安慰還是悲哀"}, {"t0": 29.6, "t1": 30.6, "text": "字幕by索兰娅"}]