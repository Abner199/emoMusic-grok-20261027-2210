[{"t0": 0.0, "t1": 4.4, "text": "时间是让人促不及防的东西"}, {"t0": 4.4, "t1": 8.4, "text": "心事有封印有水"}, {"t0": 11.4, "t1": 15.4, "text": "能够默尽的求别放浪"}, {"t0": 15.4, "t1": 19.4, "text": "能够拥抱的求别拉扯"}, {"t0": 19.4, "t1": 23.4, "text": "时间着急的冲刷着"}, {"t0": 23.4, "t1": 27.4, "text": "剩下了什么"}, {"t0": 27.4, "t1": 29.4, "text": "原谅错误过灯"}]