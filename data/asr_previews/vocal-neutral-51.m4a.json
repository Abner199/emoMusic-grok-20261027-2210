[{"t0": 0.0, "t1": 4.0, "text": "万一青年很多"}, {"t0": 4.0, "t1": 8.0, "text": "如果忘不了了"}, {"t0": 8.0, "t1": 12.0, "text": "就会来找你坐坐"}, {"t0": 12.0, "t1": 16.0, "text": "我是个沉默不遇的"}, {"t0": 16.0, "t1": 20.0, "text": "跑着墙壁晒太阳的过客"}, {"t0": 20.0, "t1": 24.0, "text": "如果我有些卷意了"}, {"t0": 24.0, "t1": 29.0, "text": "就让我在这里独自行过"}, {"t0": 29.0, "t1": 30.0, "text": "喔喔喔"}]