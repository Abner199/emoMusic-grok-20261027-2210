[{"t0": 0.0, "t1": 2.8, "text": "寒冬暮经过这里"}, {"t0": 2.8, "t1": 5.6, "text": "那只是迷雾的山林"}, {"t0": 5.6, "t1": 8.48, "text": "走完藏老地时久"}, {"t0": 8.48, "t1": 11.64, "text": "感到潮湿地味道"}, {"t0": 11.64, "t1": 13.84, "text": "放过了青山"}, {"t0": 13.84, "t1": 17.04, "text": "你说你看头听到你的人们"}, {"t0": 17.04, "t1": 20.2, "text": "海风拂过野树吹散"}, {"t0": 20.2, "t1": 22.8, "text": "一路的风尘"}, {"t0": 22.8, "t1": 25.64, "text": "这里就像云露时刻"}, {"t0": 25.64, "t1": 28.68, "text": "觉得有一个世界"}, {"t0": 28.68, "t1": 29.68, "text": "讓我們"}]