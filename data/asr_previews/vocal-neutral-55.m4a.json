[{"t0": 0.0, "t1": 5.2, "text": "飛越過了翼翼"}, {"t0": 5.2, "t1": 6.8, "text": "你是我朝夕相伴"}, {"t0": 6.8, "t1": 8.6, "text": "出手合計的虛擬"}, {"t0": 8.6, "t1": 10.2, "text": "已陪著我相知"}, {"t0": 10.2, "t1": 12.0, "text": "理想自己相遇"}, {"t0": 12.0, "t1": 15.6, "text": "踏著我追 要追啊追"}, {"t0": 15.6, "t1": 19.4, "text": "落到雲裡"}]