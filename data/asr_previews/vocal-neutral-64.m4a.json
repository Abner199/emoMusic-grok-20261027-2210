[{"t0": 0.0, "t1": 3.44, "text": "大头身被抛在脑后你看我"}, {"t0": 3.44, "t1": 7.4, "text": "我就把服务破目睹的一切"}, {"t0": 7.4, "t1": 10.88, "text": "曾识的存在这个世界"}, {"t0": 10.88, "t1": 16.44, "text": "是心灵的残觉还是现实已被忽略"}, {"t0": 16.44, "t1": 18.64, "text": "许你的傻的家"}, {"t0": 18.64, "t1": 22.2, "text": "我在另外一颗天堂"}, {"t0": 22.2, "t1": 26.4, "text": "我在其中避忘的悲伤"}, {"t0": 26.4, "t1": 29.84, "text": "冒险喷出背间许你的啥的家"}, {"t0": 29.84, "t1": 31.84, "text": "字幕by索兰娅"}]