[{"t0": 0.0, "t1": 5.0, "text": "怎会有动人旋律在对面的屋顶"}, {"t0": 5.0, "t1": 11.0, "text": "我悄悄关上门 带着希望上去"}, {"t0": 11.0, "t1": 16.0, "text": "原来是我梦里常出现的那个人"}, {"t0": 16.0, "t1": 21.0, "text": "那个人不就是我梦里那模糊的人"}, {"t0": 21.0, "t1": 26.0, "text": "我们有同样的模糊"}, {"t0": 26.0, "t1": 28.0, "text": "有点些"}, {"t0": 28.0, "t1": 30.0, "text": "有天想 太沉默"}]