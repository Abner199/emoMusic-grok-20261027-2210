[{"t0": 0.0, "t1": 3.2, "text": "有什麼毛病 有 有什麼毛病"}, {"t0": 3.2, "t1": 6.48, "text": "我很大氣 我沒你小氣"}, {"t0": 6.48, "t1": 9.76, "text": "我會原諒你 你仔細聽"}, {"t0": 9.76, "t1": 16.24, "text": "我終於愛過你 怎麼會想念你"}, {"t0": 16.24, "t1": 19.36, "text": "發著陌生機 要你說不去"}, {"t0": 19.36, "t1": 22.72, "text": "你只剩腦袋 開不進心"}, {"t0": 22.72, "t1": 29.96, "text": "其實還愛著你 其實還想著你"}]