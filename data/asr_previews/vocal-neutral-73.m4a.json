[{"t0": 0.0, "t1": 3.8, "text": "但要走 總要飛"}, {"t0": 3.8, "t1": 7.6, "text": "告別不可再等你"}, {"t0": 7.6, "t1": 10.6, "text": "不管有沒有機"}, {"t0": 10.6, "t1": 13.6, "text": "吸我體貼入你"}, {"t0": 13.6, "t1": 18.4, "text": "但你手如明日邊要遠離"}, {"t0": 18.4, "t1": 25.6, "text": "遠離可疑留下供我曾與快的意見"}, {"t0": 25.6, "t1": 29.0, "text": "當世事再沒完美"}, {"t0": 29.0, "t1": 30.0, "text": "何云"}]