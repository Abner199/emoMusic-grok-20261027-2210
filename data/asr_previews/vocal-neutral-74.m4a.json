[{"t0": 0.0, "t1": 4.24, "text": "時日會 晚宴再晚宴"}, {"t0": 4.24, "t1": 7.8, "text": "某些班河改變的改變"}, {"t0": 7.8, "t1": 11.48, "text": "如日時不曉 發現的發現"}, {"t0": 11.48, "t1": 15.28, "text": "愁者魔放大了決定"}, {"t0": 15.28, "t1": 18.84, "text": "來讓我 問誰可決定"}, {"t0": 18.84, "t1": 22.56, "text": "那些同世叫作完美之善"}, {"t0": 22.56, "t1": 29.24, "text": "我只懂得 愛你再每天"}, {"t0": 29.24, "t1": 30.24, "text": "Don't you"}]