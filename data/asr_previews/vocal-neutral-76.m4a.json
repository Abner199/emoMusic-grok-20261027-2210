[{"t0": 0.0, "t1": 4.0, "text": "陪你我的手 像温柔野手"}, {"t0": 4.0, "t1": 8.0, "text": "把自由交给草原的辽阔"}, {"t0": 8.0, "t1": 12.0, "text": "我们享受拉大手 一起交友"}, {"t0": 12.0, "t1": 15.0, "text": "今天别想太多"}, {"t0": 15.0, "t1": 18.0, "text": "你是我的梦 像北方的风"}, {"t0": 18.0, "t1": 23.0, "text": "追着南方的洋洋的哀愁"}, {"t0": 23.0, "t1": 27.0, "text": "我们享收拉大手 今天加油"}, {"t0": 27.0, "t1": 30.0, "text": "像昨天揮揮手"}]