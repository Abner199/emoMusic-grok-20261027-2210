[{"t0": 0.0, "t1": 5.0, "text": "外包既然不能逗留"}, {"t0": 5.0, "t1": 8.0, "text": "何不再离开的时候"}, {"t0": 8.0, "t1": 15.0, "text": "一边享受 一边泪流"}, {"t0": 15.0, "t1": 19.0, "text": "十年之前 我不认识你"}, {"t0": 19.0, "t1": 23.0, "text": "你不属于我 我们还是一样"}, {"t0": 23.0, "t1": 27.0, "text": "陪在一个陌生人左右"}, {"t0": 27.0, "t1": 30.0, "text": "走 走过前天熟悉"}]