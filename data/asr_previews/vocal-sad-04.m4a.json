[{"t0": 0.0, "t1": 4.0, "text": "还是什么颜色"}, {"t0": 4.0, "t1": 7.0, "text": "夜夜陪着你的海"}, {"t0": 7.0, "t1": 11.0, "text": "心情又如何"}, {"t0": 11.0, "t1": 15.0, "text": "灰色是不想说"}, {"t0": 15.0, "t1": 19.0, "text": "蓝色是忧郁"}, {"t0": 19.0, "t1": 21.0, "text": "而漂泊的你"}, {"t0": 21.0, "t1": 23.0, "text": "狂浪的心"}, {"t0": 23.0, "t1": 27.0, "text": "停在哪里"}, {"t0": 27.0, "t1": 29.0, "text": "写信告诉我"}]