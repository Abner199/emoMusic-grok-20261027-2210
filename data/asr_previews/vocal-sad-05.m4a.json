[{"t0": 0.0, "t1": 4.08, "text": "你仍記得你的模樣"}, {"t0": 4.08, "t1": 8.36, "text": "三尋就過你在角落"}, {"t0": 8.36, "t1": 12.52, "text": "固執的唱著古色的歌"}, {"t0": 12.52, "t1": 16.68, "text": "聽它在喧囂裡被淹沒"}, {"t0": 16.68, "t1": 22.88, "text": "你拿起就被對自己說"}, {"t0": 22.88, "t1": 27.2, "text": "一杯金照樣 一杯金月光"}, {"t0": 27.2, "t1": 30.0, "text": "关心我的向往 温柔了"}]