[{"t0": 0.0, "t1": 3.0, "text": "喔喔喔"}, {"t0": 3.0, "t1": 6.0, "text": "喔喔喔"}, {"t0": 6.0, "t1": 8.0, "text": "哈囉 生日的朋友"}, {"t0": 8.0, "t1": 10.0, "text": "看得清楚嗎"}, {"t0": 10.0, "t1": 11.0, "text": "很清楚對不對"}, {"t0": 11.0, "t1": 12.0, "text": "OK"}, {"t0": 12.0, "t1": 13.0, "text": "很好"}, {"t0": 13.0, "t1": 14.0, "text": "我也看得清楚你們"}, {"t0": 14.0, "t1": 15.0, "text": "所以要張開嘴巴"}, {"t0": 15.0, "t1": 17.0, "text": "跟我一起唱喔"}, {"t0": 18.0, "t1": 19.0, "text": "後面的朋友"}, {"t0": 19.0, "t1": 21.0, "text": "非常清楚喔"}, {"t0": 21.0, "t1": 22.0, "text": "謝謝"}, {"t0": 23.0, "t1": 25.0, "text": "這邊偶爾太清楚了"}, {"t0": 27.0, "t1": 28.0, "text": "來吧"}, {"t0": 29.0, "t1": 28.0, "text": ""}, {"t0": 30.0, "t1": null, "text": "美人"}]