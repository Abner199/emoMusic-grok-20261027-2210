[{"t0": 0.0, "t1": 2.0, "text": "是我太傻"}, {"t0": 2.0, "t1": 5.56, "text": "说不想爱别说话"}, {"t0": 5.56, "t1": 9.0, "text": "就一点喜欢"}, {"t0": 9.0, "t1": 12.48, "text": "说不想狠别纠缠"}, {"t0": 12.48, "t1": 15.88, "text": "别装作感叹"}, {"t0": 15.88, "t1": 18.16, "text": "就当做我太麻烦"}, {"t0": 18.16, "t1": 19.88, "text": "不停让自己受伤"}, {"t0": 19.88, "t1": 22.52, "text": "我告诉我自己"}, {"t0": 22.52, "t1": 25.96, "text": "感情就是这样"}, {"t0": 25.96, "t1": 29.96, "text": "怎么一不小心太疯狂"}]