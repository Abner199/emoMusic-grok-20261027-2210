[{"t0": 0.0, "t1": 2.0, "text": "寂寞"}, {"t0": 2.0, "t1": 8.0, "text": "我們愛的沒有錯"}, {"t0": 8.0, "t1": 12.0, "text": "只是美麗的獨秀"}, {"t0": 12.0, "t1": 15.0, "text": "太折磨"}, {"t0": 15.0, "t1": 19.0, "text": "他說無所謂"}, {"t0": 19.0, "t1": 22.0, "text": "只要能在夜裡"}, {"t0": 22.0, "t1": 24.0, "text": "翻來覆去的時候"}, {"t0": 24.0, "t1": 26.0, "text": "又寂寬"}, {"t0": 26.0, "t1": 28.0, "text": "等不到天黑"}, {"t0": 28.0, "t1": 30.0, "text": "掩護骨灰"}]