[{"t0": 0.0, "t1": 4.52, "text": "花返鋪滿心裡奮唱才害怕"}, {"t0": 4.52, "t1": 6.84, "text": "如約你非我不嫁"}, {"t0": 6.84, "t1": 9.12, "text": "彼此終別火化"}, {"t0": 9.12, "t1": 13.64, "text": "一生一世等一天需要代價"}, {"t0": 13.64, "t1": 14.84, "text": "誰都只等"}, {"t0": 14.84, "t1": 18.84, "text": "那雙手靠擁抱亦能任你擁有"}, {"t0": 18.84, "t1": 23.4, "text": "要擁有別線等失去怎接受"}, {"t0": 23.4, "t1": 25.68, "text": "曾願著雪露流油"}, {"t0": 25.68, "t1": 27.92, "text": "為何為好事淚流"}, {"t0": 27.92, "t1": 29.96, "text": "誰能憑愛意要"}, {"t0": 29.96, "t1": 31.96, "text": "字幕by索兰娅"}]