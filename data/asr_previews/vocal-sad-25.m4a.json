[{"t0": 0.0, "t1": 5.44, "text": "學會珍惜 堅持和低調"}, {"t0": 5.44, "t1": 9.68, "text": "有時候 有時候"}, {"t0": 9.68, "t1": 13.92, "text": "我會相信 一切有盡頭"}, {"t0": 13.92, "t1": 18.24, "text": "想去離開 都有時候"}, {"t0": 18.24, "t1": 22.56, "text": "也有什麼 會不睡不休"}, {"t0": 22.56, "t1": 26.72, "text": "可是我有時候"}, {"t0": 26.72, "t1": 29.92, "text": "宁愿选择留恋不放"}]