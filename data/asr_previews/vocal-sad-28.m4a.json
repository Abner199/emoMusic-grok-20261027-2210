[{"t0": 0.0, "t1": 4.0, "text": "我总以为你有天会感动"}, {"t0": 4.0, "t1": 16.0, "text": "关于留言我装作无动宇宙"}, {"t0": 16.0, "t1": 19.0, "text": "直到所有的梦里破碎"}, {"t0": 19.0, "t1": 24.0, "text": "才看见你的眼泪和后悔"}, {"t0": 24.0, "t1": 26.0, "text": "我是多想再给你机会"}, {"t0": 26.0, "t1": 29.0, "text": "多想问你究竟"}, {"t0": 29.0, "t1": 30.0, "text": "愛誰"}]