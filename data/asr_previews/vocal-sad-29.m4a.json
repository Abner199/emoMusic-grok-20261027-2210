[{"t0": 0.0, "t1": 4.5, "text": "所有一切你要的爱"}, {"t0": 4.5, "t1": 9.4, "text": "因为在一千年以后"}, {"t0": 9.4, "t1": 13.4, "text": "世界早已没有我"}, {"t0": 13.4, "t1": 17.5, "text": "无法深情望着你的手"}, {"t0": 17.5, "t1": 20.4, "text": "坚吻着你耳朵"}, {"t0": 20.4, "t1": 24.9, "text": "别难道一千年之后"}, {"t0": 24.9, "t1": 29.1, "text": "所有人都遗忘了我"}, {"t0": 29.1, "t1": 30.1, "text": "那時候"}]