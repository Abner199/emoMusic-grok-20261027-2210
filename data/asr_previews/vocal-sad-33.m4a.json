[{"t0": 0.0, "t1": 5.0, "text": "人總需要勇敢生存"}, {"t0": 5.0, "t1": 8.0, "text": "我還是重新去遠"}, {"t0": 8.0, "t1": 15.0, "text": "例如何會成熟失戀"}, {"t0": 15.0, "t1": 19.0, "text": "明年今日必要再失眠"}, {"t0": 19.0, "t1": 21.0, "text": "創欲都改變"}, {"t0": 21.0, "t1": 23.0, "text": "如果有幸會面"}, {"t0": 23.0, "t1": 27.0, "text": "或再同本身分的承認"}, {"t0": 27.0, "t1": 30.0, "text": "希望我可以等待你"}]