[{"t0": 0.0, "t1": 4.2, "text": "保持我的沉默 明白什么才是好的"}, {"t0": 4.2, "t1": 7.66, "text": "坏的都散了 散了太多"}, {"t0": 7.66, "t1": 13.12, "text": "不管的散了后我醒了 醒了醒了"}, {"t0": 13.12, "t1": 17.06, "text": "醒了"}, {"t0": 17.06, "t1": 20.52, "text": "过了很久终于我原来都看"}, {"t0": 20.52, "t1": 23.7, "text": "你就在对岸走的好满人"}, {"t0": 23.7, "t1": 29.96, "text": "由我独自在这美与现实之间两岗"}]