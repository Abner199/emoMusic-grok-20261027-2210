[{"t0": 0.0, "t1": 4.6, "text": "總舖難來難射 雙舖緊射"}, {"t0": 4.6, "t1": 8.32, "text": "看望人生好像荒野"}, {"t0": 8.32, "t1": 11.96, "text": "如海而能覆 於爬爬的肩膀"}, {"t0": 11.96, "t1": 15.68, "text": "誰要下車"}, {"t0": 15.68, "t1": 19.32, "text": "難來難捨 總有一射"}, {"t0": 19.32, "t1": 23.08, "text": "相情如此不可推卸"}, {"t0": 23.08, "t1": 26.72, "text": "任世間再冷酷 上起這單車"}, {"t0": 26.72, "t1": 30.02, "text": "環遊橫風"}]