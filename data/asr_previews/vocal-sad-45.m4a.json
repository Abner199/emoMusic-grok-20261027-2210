[{"t0": 0.0, "t1": 4.4, "text": "想念是會呼吸的痛"}, {"t0": 4.4, "t1": 9.0, "text": "它活在我身上所有角落"}, {"t0": 9.0, "t1": 11.6, "text": "恨你愛的多會痛"}, {"t0": 11.6, "t1": 14.0, "text": "看你的心會痛"}, {"t0": 14.0, "t1": 17.6, "text": "戀著我也痛"}, {"t0": 17.6, "t1": 21.6, "text": "你還是會呼吸得痛"}, {"t0": 21.6, "t1": 26.0, "text": "它留在血液中來回滾動"}, {"t0": 26.0, "t1": 28.6, "text": "後悔不貼心會痛"}, {"t0": 28.6, "t1": 29.6, "text": "恨不懂你"}]