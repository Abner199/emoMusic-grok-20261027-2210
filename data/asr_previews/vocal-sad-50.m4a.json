[{"t0": 0.0, "t1": 3.4, "text": "你是 明月晶峰"}, {"t0": 3.4, "t1": 8.4, "text": "或是你 周覆的梦"}, {"t0": 8.4, "t1": 14.4, "text": "間距不見 都為生與你相擁"}, {"t0": 14.4, "t1": 18.4, "text": "而若將來 你所愛的人間"}, {"t0": 18.4, "t1": 22.4, "text": "願你所願的宵夜"}, {"t0": 22.4, "t1": 25.4, "text": "你的手 我拍身再見"}, {"t0": 25.4, "t1": 28.4, "text": "請帶我去 明天"}, {"t0": 28.4, "t1": 30.4, "text": "不顾胜利"}]