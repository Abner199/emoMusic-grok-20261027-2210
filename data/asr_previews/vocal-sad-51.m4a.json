[{"t0": 0.0, "t1": 3.8, "text": "你给的真是空白"}, {"t0": 3.8, "t1": 7.0, "text": "一个人假日发呆"}, {"t0": 7.0, "t1": 11.0, "text": "找不到人陪我搁脉"}, {"t0": 11.0, "t1": 14.8, "text": "我在幸福的梦外"}, {"t0": 14.8, "t1": 18.4, "text": "却一直都进不来"}, {"t0": 18.4, "t1": 21.8, "text": "你泪滞给的伤害"}, {"t0": 21.8, "t1": 25.4, "text": "我是真的恨的释怀"}, {"t0": 25.4, "t1": 29.0, "text": "终于看开爱回不来"}, {"t0": 29.0, "t1": 30.0, "text": "字幕by索兰娅"}]