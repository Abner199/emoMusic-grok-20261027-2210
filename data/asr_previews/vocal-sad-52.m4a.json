[{"t0": 0.0, "t1": 11.0, "text": "Zither Harp"}, {"t0": 12.0, "t1": 15.0, "text": "還沒到的一碗雞"}, {"t0": 15.0, "t1": 18.0, "text": "還沒用的舊相機"}, {"t0": 18.0, "t1": 21.0, "text": "還沒光臨的餐廳"}, {"t0": 21.0, "t1": 24.0, "text": "還在期待有著你的旅行"}, {"t0": 24.0, "t1": 27.0, "text": "當那日落的芭蕾"}, {"t0": 27.0, "t1": 29.76, "text": "它只想牵著你"}]