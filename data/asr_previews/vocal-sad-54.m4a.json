[{"t0": 0.0, "t1": 5.0, "text": "我这边没到黄昏的时候"}, {"t0": 5.0, "t1": 10.0, "text": "就开始过去风流"}, {"t0": 10.0, "t1": 12.0, "text": "但那些放了学不回家"}, {"t0": 12.0, "t1": 18.0, "text": "低孩子们正玩了热闹"}, {"t0": 18.0, "t1": 20.0, "text": "古老这边的人和车"}, {"t0": 20.0, "t1": 26.0, "text": "一千两年多了寒冬"}, {"t0": 26.0, "t1": 29.0, "text": "我很少出门偶尔发现过去"}, {"t0": 29.0, "t1": 30.0, "text": "与情所不处"}]