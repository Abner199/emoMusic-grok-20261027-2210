[{"t0": 0.0, "t1": 3.72, "text": "流成了枷锁"}, {"t0": 3.72, "t1": 10.48, "text": "现实中幸福永远缺货"}, {"t0": 10.48, "t1": 14.52, "text": "请告诉他我不爱他"}, {"t0": 14.52, "t1": 18.76, "text": "笑着难过自我惩罚"}, {"t0": 18.76, "t1": 22.52, "text": "想终止这一切挣扎"}, {"t0": 22.52, "t1": 26.52, "text": "恨了心说真心幻话"}, {"t0": 26.52, "t1": 29.96, "text": "别告诉他我还想他"}]