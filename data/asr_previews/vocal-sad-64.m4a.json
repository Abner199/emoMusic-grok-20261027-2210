[{"t0": 0.0, "t1": 7.0, "text": "幻幻飄落的蜂蜜像十年"}, {"t0": 7.0, "t1": 14.0, "text": "我眼人轻轟温暖岁末的秋天"}, {"t0": 14.0, "t1": 17.0, "text": "几光月断点遍"}, {"t0": 17.0, "t1": 21.0, "text": "美风月过上你的容颜"}, {"t0": 21.0, "t1": 25.0, "text": "我们爱上成了落叶"}, {"t0": 25.0, "t1": 27.0, "text": "却幻不会消失"}, {"t0": 27.0, "t1": 29.0, "text": "絕關不會消失"}]