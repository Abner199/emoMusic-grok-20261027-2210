[{"t0": 0.0, "t1": 6.0, "text": "很久 很久 很久以後"}, {"t0": 6.0, "t1": 13.0, "text": "到你牽著別個他的手"}, {"t0": 13.0, "t1": 16.0, "text": "我們這個傷口"}, {"t0": 16.0, "t1": 19.0, "text": "也許不再難受"}, {"t0": 19.0, "t1": 22.0, "text": "好久不見的朋友"}, {"t0": 22.0, "t1": 25.0, "text": "祝福你們"}, {"t0": 25.0, "t1": 28.0, "text": "直到永久"}, {"t0": 28.0, "t1": 30.0, "text": "只只怕看你"}]