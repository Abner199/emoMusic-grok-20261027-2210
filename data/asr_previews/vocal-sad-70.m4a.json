[{"t0": 0.0, "t1": 6.0, "text": "看你傻傻的 握住我的手"}, {"t0": 6.0, "t1": 10.0, "text": "很可惜沒有順風"}, {"t0": 10.0, "t1": 13.0, "text": "的愛你變不孤獨"}, {"t0": 13.0, "t1": 21.0, "text": "不會再讓你哭"}, {"t0": 21.0, "t1": 24.0, "text": "我被你找到最後"}, {"t0": 24.0, "t1": 28.0, "text": "難不難不要回頭"}, {"t0": 28.0, "t1": 30.0, "text": "你靜靜的吧"}]