[{"t0": 0.0, "t1": 5.0, "text": "突然你失踪"}, {"t0": 5.0, "t1": 9.0, "text": "曾聽說過你某夜結婚"}, {"t0": 9.0, "t1": 12.0, "text": "未曾老笑容"}, {"t0": 12.0, "t1": 19.0, "text": "實在不敢知道我是元兇"}, {"t0": 19.0, "t1": 23.0, "text": "大概當初我未懂得估計"}, {"t0": 23.0, "t1": 26.0, "text": "令少數性害慘你"}, {"t0": 26.0, "t1": 28.0, "text": "令人受傷之味"}, {"t0": 28.0, "t1": 30.0, "text": "眼報更可悲"}]