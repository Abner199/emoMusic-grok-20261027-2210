[{"t0": 0.0, "t1": 2.5, "text": "看我這一把 總要附加一點驕傲"}, {"t0": 2.5, "t1": 4.5, "text": "我相信YouTube 要被打開"}, {"t0": 4.5, "t1": 7.0, "text": "動作就自在 沒想過來"}, {"t0": 7.0, "t1": 9.5, "text": "你懂得抓白豆 只能撞開"}, {"t0": 9.5, "t1": 12.0, "text": "做夢 給它出數 更被欺負"}, {"t0": 12.0, "t1": 14.0, "text": "我相信 YouTube 要把打開"}, {"t0": 14.0, "t1": 16.5, "text": "動作就撞開 給你撞開"}, {"t0": 16.5, "t1": 19.0, "text": "我相信你Tube 要不先被打開"}, {"t0": 19.0, "t1": 21.5, "text": "進去 給它下來 感謝你開"}]