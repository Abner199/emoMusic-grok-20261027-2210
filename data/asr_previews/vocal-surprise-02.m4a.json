[{"t0": 0.0, "t1": 1.0, "text": "一起拽下來"}, {"t0": 1.0, "t1": 3.0, "text": "到了右邊找茶牌"}, {"t0": 3.0, "t1": 6.0, "text": "来右手跟我一起拽下来"}, {"t0": 6.0, "t1": 8.0, "text": "到了左边再找茶牺"}, {"t0": 8.0, "t1": 9.0, "text": "文陀"}, {"t0": 9.0, "t1": 11.0, "text": "在年薰前划过一道安全带"}, {"t0": 11.0, "t1": 13.0, "text": "车开起来不失态"}, {"t0": 13.0, "t1": 14.0, "text": "开快开慢"}, {"t0": 14.0, "t1": 16.0, "text": "危险随时可能来"}, {"t0": 16.0, "t1": 18.0, "text": "记住安全这条带"}, {"t0": 18.0, "t1": 20.0, "text": "开车要带"}, {"t0": 20.0, "t1": 23.0, "text": "坐在副驾驶要带"}, {"t0": 23.0, "t1": 25.0, "text": "坐在后排要带"}, {"t0": 25.0, "t1": 28.0, "text": "安全带不能不带"}, {"t0": 28.0, "t1": 30.0, "text": "儿女出门在外"}]