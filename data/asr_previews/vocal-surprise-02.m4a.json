[{"t0": 0.0, "t1": 1.2, "text": "一起拽下来"}, {"t0": 1.2, "t1": 3.64, "text": "到了右边找插牌"}, {"t0": 3.64, "t1": 6.08, "text": "来右手跟我一起拽上来"}, {"t0": 6.08, "t1": 7.96, "text": "到了左边再找揸牌"}, {"t0": 7.96, "t1": 9.48, "text": "文拓在年薪前"}, {"t0": 9.48, "t1": 10.96, "text": "划过一道安全带"}, {"t0": 10.96, "t1": 13.44, "text": "车开起来不失态"}, {"t0": 13.44, "t1": 15.84, "text": "开快开慢危险随时可能来"}, {"t0": 15.84, "t1": 18.64, "text": "记住安全这条带"}, {"t0": 18.64, "t1": 20.12, "text": "开车要带"}, {"t0": 20.12, "t1": 22.88, "text": "坐在副驾驶要带"}, {"t0": 22.88, "t1": 25.08, "text": "坐在后排要带"}, {"t0": 25.08, "t1": 27.84, "text": "安全带不能不带"}, {"t0": 27.84, "t1": 29.84, "text": "儿女出门在外"}]