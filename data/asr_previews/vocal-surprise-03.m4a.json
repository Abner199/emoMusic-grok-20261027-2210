[{"t0": 0.0, "t1": 3.0, "text": "一颗心不懂不懂的狂跳"}, {"t0": 3.0, "t1": 7.0, "text": "一瞬间烦恼烦恶烦 要绝忘掉"}, {"t0": 7.0, "t1": 11.0, "text": "我再也不跳 再也不要"}, {"t0": 11.0, "t1": 14.0, "text": "委屈自己一秒"}, {"t0": 14.0, "t1": 21.0, "text": "一寸天烦恚烦恣 要续忘掉"}, {"t0": 21.0, "t1": 25.0, "text": "我随意当地球 地球摔掉"}, {"t0": 25.0, "t1": 29.0, "text": "只要越跳越高"}]