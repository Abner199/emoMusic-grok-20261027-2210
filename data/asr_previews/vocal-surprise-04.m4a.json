[{"t0": 0.0, "t1": 2.76, "text": "岸子前红一片海"}, {"t0": 2.76, "t1": 4.44, "text": "花蓝蓝的歌谣"}, {"t0": 4.44, "t1": 6.6, "text": "是我们的期待"}, {"t0": 6.6, "t1": 10.32, "text": "一路边走边唱才是最存在"}, {"t0": 10.32, "t1": 14.16, "text": "我们要唱就要唱的最痛快"}, {"t0": 14.16, "t1": 17.92, "text": "你是我眼前最美的人才"}, {"t0": 17.92, "t1": 20.76, "text": "让我用心把你等下来"}, {"t0": 20.76, "t1": 21.6, "text": "你就是"}, {"t0": 21.6, "t1": 25.44, "text": "悠悠地唱着最悬的民族风"}, {"t0": 25.44, "t1": 28.56, "text": "让爱卷走所有的尘埃"}, {"t0": 28.56, "t1": 29.32, "text": "你就是"}, {"t0": 29.32, "t1": 29.82, "text": "by bwd6"}]