[{"t0": 0.0, "t1": 5.6, "text": "我被他拖著走緊緊叫著我"}, {"t0": 5.6, "t1": 10.6, "text": "我離開陷入了微星邊緣邊邊"}, {"t0": 10.6, "t1": 17.0, "text": "我的世界一狂風把無語"}, {"t0": 17.0, "t1": 20.0, "text": "愛情來得太快就像龍泉"}, {"t0": 20.0, "t1": 23.0, "text": "風裡不開暴風卻來不及偷"}, {"t0": 23.0, "t1": 26.6, "text": "我不能再傷我不能再伤"}, {"t0": 26.6, "t1": 29.6, "text": "我不我不我不能"}, {"t0": 29.6, "t1": 31.6, "text": "字幕by索兰娅"}]