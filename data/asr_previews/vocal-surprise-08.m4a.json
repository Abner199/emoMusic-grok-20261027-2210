[{"t0": 0.0, "t1": 3.8, "text": "他们中一个人生活"}, {"t0": 3.8, "t1": 6.12, "text": "看见远方天国"}, {"t0": 6.12, "t1": 8.2, "text": "那脆残的烟火"}, {"t0": 8.2, "t1": 10.64, "text": "HER HER HES TEN"}, {"t0": 10.64, "t1": 15.84, "text": "YO YO GO GO GO"}, {"t0": 15.84, "t1": 17.12, "text": "YO YO GO"}, {"t0": 17.12, "t1": 20.36, "text": "这这感觉就像一个方向"}, {"t0": 20.36, "t1": 21.96, "text": "还有不是轻薄"}, {"t0": 21.96, "t1": 24.56, "text": "转转连着像那些深黑阴火"}, {"t0": 24.56, "t1": 27.08, "text": "一路的方向让我不停琢磨"}, {"t0": 27.08, "t1": 29.68, "text": "YO YO GOGO GO GO"}, {"t0": 29.68, "t1": 31.68, "text": "字幕by索兰娅"}]