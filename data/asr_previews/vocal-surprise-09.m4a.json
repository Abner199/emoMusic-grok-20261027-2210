[{"t0": 0.0, "t1": 2.0, "text": "自己"}, {"t0": 2.0, "t1": 4.0, "text": "我雖然是個牛仔"}, {"t0": 4.0, "t1": 6.0, "text": "在酒吧治療牛奶"}, {"t0": 6.0, "t1": 8.0, "text": "為什麼不喝啤酒"}, {"t0": 8.0, "t1": 10.0, "text": "因為啤酒傷身體"}, {"t0": 10.0, "t1": 12.0, "text": "很多人不長眼睛"}, {"t0": 12.0, "t1": 14.0, "text": "小城都靠武器"}, {"t0": 14.0, "t1": 18.0, "text": "只收空權就收成螞蟻"}, {"t0": 18.0, "t1": 22.0, "text": "不用換盤了"}, {"t0": 22.0, "t1": 23.0, "text": "你們一起上午餐乾之前"}, {"t0": 23.0, "t1": 24.0, "text": "每天全都關燈燈了了"}, {"t0": 24.0, "t1": 25.0, "text": "夜宵夜夜了了"}, {"t0": 25.0, "t1": 27.0, "text": "不用關盤了"}, {"t0": 27.0, "t1": 28.0, "text": "如果不上你們一起去"}, {"t0": 28.0, "t1": 29.0, "text": "一起上午了"}, {"t0": 29.0, "t1": 30.0, "text": "say you want one"}]