[{"t0": 0.0, "t1": 2.0, "text": "自己"}, {"t0": 2.0, "t1": 4.0, "text": "我生生的牛仔"}, {"t0": 4.0, "t1": 6.0, "text": "在酒吧之旅牛奶"}, {"t0": 6.0, "t1": 8.0, "text": "为什么不喝啤酒"}, {"t0": 8.0, "t1": 10.0, "text": "因为啤酒上山地"}, {"t0": 10.0, "t1": 12.0, "text": "很多人不张眼睛"}, {"t0": 12.0, "t1": 14.0, "text": "小城都看我记"}, {"t0": 14.0, "t1": 18.0, "text": "这首空拳就说这么一样"}, {"t0": 18.0, "t1": 19.0, "text": "别忘了 别忘了"}, {"t0": 19.0, "t1": 20.0, "text": "别忘了别忘了"}, {"t0": 20.0, "t1": 21.0, "text": "别忘了"}, {"t0": 21.0, "t1": 22.0, "text": "别忘了"}, {"t0": 22.0, "t1": 23.0, "text": "明明一起散火在干涉前"}, {"t0": 23.0, "t1": 24.0, "text": "每天去到花灯都来了"}, {"t0": 24.0, "t1": 25.0, "text": "一宿一来啦"}, {"t0": 25.0, "t1": 26.0, "text": "别忘了"}, {"t0": 26.0, "t1": 27.0, "text": "别忘了"}, {"t0": 27.0, "t1": 28.0, "text": "组个火葬明明一起喝"}, {"t0": 28.0, "t1": 29.0, "text": "一起散好了"}, {"t0": 29.0, "t1": 30.0, "text": "say more more"}]