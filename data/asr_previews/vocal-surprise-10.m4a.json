[{"t0": 0.0, "t1": 3.24, "text": "我依然沒有發現一個月後我去第二個城市"}, {"t0": 3.24, "t1": 5.76, "text": "這裡的人們稱它為美麗之都"}, {"t0": 5.76, "t1": 8.24, "text": "其實過來很快 夜幕就要降臨"}, {"t0": 8.24, "t1": 10.0, "text": "我想我必須要離開"}, {"t0": 10.0, "t1": 12.6, "text": "當我真要走時我看到一家專賣店"}, {"t0": 12.6, "t1": 15.4, "text": "那就是我要的花瓣鞋"}, {"t0": 15.4, "t1": 18.6, "text": "那就是我要了花瓢鞋"}, {"t0": 18.6, "t1": 21.0, "text": "我的花瓪鞋時尚時尚隨時尚"}, {"t0": 21.0, "t1": 23.6, "text": "火車的路上我進步自盡摩擦"}, {"t0": 23.6, "t1": 25.6, "text": "摩擮摩在這光滑的地上"}, {"t0": 25.6, "t1": 27.6, "text": "摩撒 摩撮"}, {"t0": 27.6, "t1": 29.6, "text": "在这光滑地上沐洒"}]