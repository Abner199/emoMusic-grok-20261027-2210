[{"t0": 0.0, "t1": 2.0, "text": "很醉了没"}, {"t0": 2.0, "t1": 5.5, "text": "白雪下夜不不惊羡"}, {"t0": 5.5, "t1": 7.5, "text": "模糊了蝙蜜"}, {"t0": 7.5, "t1": 10.0, "text": "时光的下落被我踩碎"}, {"t0": 17.5, "t1": 21.0, "text": "故事刻画在旋转的之间"}, {"t0": 21.0, "t1": 25.0, "text": "是谁带出去的醉醉"}, {"t0": 25.0, "t1": 28.5, "text": "这一夜的破旧荒宫的太监"}, {"t0": 28.5, "t1": 29.9, "text": "我忘记得我"}]