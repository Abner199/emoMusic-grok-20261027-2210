[{"t0": 0.0, "t1": 4.48, "text": "这只苹果"}, {"t0": 4.48, "t1": 7.44, "text": "我的念头不再啰嗦"}, {"t0": 7.44, "t1": 12.04, "text": "现实间能如作"}, {"t0": 12.04, "t1": 15.2, "text": "请你不要到处勾勾"}, {"t0": 15.2, "t1": 17.36, "text": "早就需要勾勃"}, {"t0": 17.36, "t1": 21.6, "text": "不想心脏没勾勞"}, {"t0": 21.6, "t1": 23.76, "text": "用力到处够勾"}, {"t0": 23.76, "t1": 25.92, "text": "挂到所有勾勒"}, {"t0": 25.92, "t1": 29.92, "text": "埋伏到绝望"}]