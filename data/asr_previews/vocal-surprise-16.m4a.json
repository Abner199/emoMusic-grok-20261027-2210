[{"t0": 0.0, "t1": 1.8, "text": "谁透露雨的范围"}, {"t0": 1.8, "t1": 6.2, "text": "三位消失在那河边"}, {"t0": 6.2, "t1": 9.52, "text": "深夜流星更迷远远"}, {"t0": 9.52, "t1": 11.88, "text": "梦见面我跳过山梦园"}, {"t0": 11.88, "t1": 15.0, "text": "转身我来到北厉的街街"}, {"t0": 15.0, "t1": 19.6, "text": "好心开眼"}, {"t0": 19.6, "t1": 23.0, "text": "那些追向一支血"}, {"t0": 23.0, "t1": 26.32, "text": "向前的词是我的诗别"}, {"t0": 26.32, "t1": 29.68, "text": "我爱谁也不爱谁"}, {"t0": 29.68, "t1": 31.68, "text": "字幕by索兰娅"}]