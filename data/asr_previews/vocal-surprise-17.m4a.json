[{"t0": 0.0, "t1": 3.0, "text": "那张路上却被我收药"}, {"t0": 3.0, "t1": 7.0, "text": "不论色套你分分差不明用心中"}, {"t0": 7.0, "t1": 11.0, "text": "我却能够绕起你的脊椎颠倒"}, {"t0": 11.0, "t1": 15.0, "text": "当过这个流离在真正朋友的敏感"}, {"t0": 15.0, "t1": 18.0, "text": "像我的习惯被你感受"}, {"t0": 18.0, "t1": 21.0, "text": "而它微笑一肚烟药"}, {"t0": 21.0, "t1": 26.0, "text": "我只要叫出你心里"}, {"t0": 26.0, "t1": 28.0, "text": "你光暗的模样"}, {"t0": 28.0, "t1": 30.0, "text": "我微笑安靜心"}]