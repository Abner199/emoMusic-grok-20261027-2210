[{"t0": 0.0, "t1": 4.56, "text": "在我地板车里的电灯火车"}, {"t0": 4.56, "t1": 7.48, "text": "把一眼像个人用力缺帐筷子"}, {"t0": 7.48, "t1": 10.2, "text": "还是在等着我个人的特色"}, {"t0": 10.2, "t1": 13.08, "text": "为了带你车 坚持到这地址车"}, {"t0": 13.08, "t1": 15.84, "text": "在我地摩托车 给你带你火车"}, {"t0": 15.84, "t1": 18.68, "text": "现在在等着 我们的钱无几个"}, {"t0": 18.68, "t1": 21.48, "text": "跑了个云车 被你抵抄了车"}, {"t0": 21.48, "t1": 24.08, "text": "把你扑起车 进去不止车车"}, {"t0": 24.08, "t1": 26.36, "text": "每个过程地方 到底什么一车"}, {"t0": 26.36, "t1": 28.28, "text": "都把一位车 碰上了个车"}, {"t0": 28.28, "t1": 30.28, "text": "哪有你多麽多方才有你"}]