[{"t0": 0.0, "t1": 3.6, "text": "改變 再見"}, {"t0": 3.6, "t1": 6.8, "text": "美麗極限 愛漂亮沒有充電"}, {"t0": 6.8, "t1": 10.2, "text": "追求完美的情節 人不愛每天"}, {"t0": 10.2, "t1": 14.2, "text": "註定別別氣餒 就觀念跑到一邊"}, {"t0": 14.2, "t1": 18.0, "text": "現在就開始改變 把絕顏都飛上"}, {"t0": 18.0, "t1": 21.6, "text": "今天 無所謂 完打絕不絕現"}, {"t0": 21.6, "t1": 25.2, "text": "讓彼此再高一點 空氣再新鮮"}, {"t0": 25.2, "t1": 28.8, "text": "再見但眼閉再見 要微再小一點"}, {"t0": 28.8, "t1": 29.8, "text": "努力展示"}]