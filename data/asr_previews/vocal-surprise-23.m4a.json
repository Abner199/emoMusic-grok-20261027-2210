[{"t0": 0.0, "t1": 2.0, "text": "日落下的雨灰"}, {"t0": 2.0, "t1": 4.0, "text": "永远的机会"}, {"t0": 4.0, "t1": 6.0, "text": "拥挤的城市"}, {"t0": 6.0, "t1": 8.0, "text": "不满了虚伪"}, {"t0": 8.0, "t1": 10.0, "text": "何必去辩解"}, {"t0": 10.0, "t1": 12.0, "text": "谁错我是对"}, {"t0": 12.0, "t1": 14.0, "text": "就让一切回归"}, {"t0": 14.0, "t1": 16.0, "text": "同欧阵的滋味"}, {"t0": 16.0, "t1": 18.0, "text": "那自由的感觉"}, {"t0": 18.0, "t1": 20.0, "text": "如果迎着风"}, {"t0": 20.0, "t1": 22.0, "text": "就飞"}, {"t0": 22.0, "t1": 24.0, "text": "复看这世界"}, {"t0": 24.0, "t1": 26.0, "text": "有多远"}, {"t0": 26.0, "t1": 28.0, "text": "有多独特"}, {"t0": 28.0, "t1": 30.0, "text": "世界"}]