[{"t0": 0.0, "t1": 3.0, "text": "無為命 為愛 而跳"}, {"t0": 3.0, "t1": 7.0, "text": "讓身體無極限 一笑再笑"}, {"t0": 7.0, "t1": 11.0, "text": "這個義務為命 我當然要"}, {"t0": 11.0, "t1": 13.0, "text": "深愛我的你"}, {"t0": 13.0, "t1": 16.0, "text": "心上最盡力 無極心跳躍"}, {"t0": 23.0, "t1": 26.0, "text": "若無故意沉浮於疲憊"}, {"t0": 26.0, "t1": 29.0, "text": "我不累 我是鬼"}]