[{"t0": 0.0, "t1": 2.68, "text": "都瘋狼冥格的唇印"}, {"t0": 2.68, "t1": 5.36, "text": "卷在窗林小桌瓶簧的蜻蜓"}, {"t0": 5.36, "t1": 7.36, "text": "对着风温柔回忆"}, {"t0": 7.36, "t1": 10.86, "text": "原来爱歌一踢踢"}, {"t0": 10.86, "t1": 15.32, "text": "Matterly is a 突然的想念你"}, {"t0": 15.32, "t1": 17.36, "text": "踩破玻璃前的声音"}, {"t0": 17.36, "t1": 18.84, "text": "只有孤单的浓衣"}, {"t0": 18.84, "t1": 23.32, "text": "Matterly Is a 突然后想念你"}, {"t0": 23.32, "t1": 26.32, "text": "我带着爱说情的原型"}]