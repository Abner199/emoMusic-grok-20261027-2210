[{"t0": 0.0, "t1": 3.8, "text": "轻点亮夜的星光"}, {"t0": 3.8, "t1": 8.6, "text": "谁为我添一件梦的衣裳"}, {"t0": 8.6, "t1": 13.4, "text": "推开那扇星窗远远的网"}, {"t0": 13.4, "t1": 18.2, "text": "谁猜下那一朵昨日的忧伤"}, {"t0": 18.2, "t1": 23.0, "text": "我想至于儿在你的河堂"}, {"t0": 23.0, "t1": 27.8, "text": "只为和你守候那脚白月光"}, {"t0": 27.8, "t1": 30.0, "text": "又過了四季"}]