[{"t0": 0.0, "t1": 7.0, "text": "你是花花水角裡鮮涼般的花花蝴蝶"}, {"t0": 7.0, "t1": 11.0, "text": "美女們只是比較活出去比較趕一點"}, {"t0": 11.0, "t1": 15.0, "text": "花蠱蝶的眉點眼的鮮肉眉散身提眼"}, {"t0": 15.0, "t1": 19.0, "text": "那些路人家們憑什麼發言惹人討厭"}, {"t0": 19.0, "t1": 23.0, "text": "快離開冬眠 趕快破劍"}, {"t0": 23.0, "t1": 26.0, "text": "被無聊空在地就表面"}, {"t0": 26.0, "t1": 30.0, "text": "向靈魂铸角 甩平凡嘴脸"}]