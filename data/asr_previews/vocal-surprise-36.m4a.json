[{"t0": 0.0, "t1": 1.24, "text": "全身无态"}, {"t0": 1.24, "t1": 3.44, "text": "再生英雄 战杀无态"}, {"t0": 3.44, "t1": 5.92, "text": "我出门了再四个的门"}, {"t0": 5.92, "t1": 8.16, "text": "杜洛伦框24寸"}, {"t0": 8.16, "t1": 9.76, "text": "今生我的目的明"}, {"t0": 9.76, "t1": 10.64, "text": "吃我们Buffery"}, {"t0": 10.64, "t1": 12.52, "text": "该带到全世界"}, {"t0": 12.52, "t1": 14.84, "text": "假乱了新的都市代"}, {"t0": 14.84, "t1": 16.96, "text": "你们进入自由都市"}, {"t0": 16.96, "t1": 19.0, "text": "新的突破 新的利红"}, {"t0": 19.0, "t1": 21.48, "text": "还是你们爱的该是英雄"}, {"t0": 21.48, "t1": 22.48, "text": "把手拎击"}, {"t0": 22.48, "t1": 24.68, "text": "开拓大声听见的声音"}, {"t0": 24.68, "t1": 26.44, "text": "又是无声到白的"}, {"t0": 26.44, "t1": 28.16, "text": "公民有着流行妙"}, {"t0": 28.16, "t1": 29.96, "text": "莫乏我自己的不柔"}]