[{"t0": 0.0, "t1": 2.0, "text": "想出現就出現"}, {"t0": 2.0, "t1": 4.0, "text": "想不見就不見"}, {"t0": 4.0, "t1": 6.0, "text": "想睡就睡一天"}, {"t0": 6.0, "t1": 8.0, "text": "不離人而人"}, {"t0": 8.0, "t1": 10.0, "text": "不回店"}, {"t0": 10.0, "t1": 12.0, "text": "不上線"}, {"t0": 12.0, "t1": 14.0, "text": "不回合人"}, {"t0": 14.0, "t1": 16.0, "text": "合人偵編"}, {"t0": 16.0, "t1": 17.0, "text": "思念是他"}, {"t0": 17.0, "t1": 18.0, "text": "但卻覺得危險"}, {"t0": 18.0, "t1": 20.0, "text": "愛上他危險危險"}, {"t0": 20.0, "t1": 22.0, "text": "不愛他思念思念"}, {"t0": 22.0, "t1": 25.0, "text": "他總是弱勁弱力弱贏弱險"}, {"t0": 25.0, "t1": 26.0, "text": "思念是你"}, {"t0": 26.0, "t1": 28.0, "text": "有時候沉默冰冷"}, {"t0": 28.0, "t1": 29.0, "text": "有時候溫柔綿甜"}, {"t0": 29.0, "t1": 30.0, "text": "面前认识"}]