[{"t0": 0.0, "t1": 3.6, "text": "別忘掉夕雨 快勇往直前"}, {"t0": 3.6, "t1": 7.6, "text": "手上最錯難免 都只在紀念"}, {"t0": 7.6, "t1": 11.0, "text": "當當雨 減亡美的人生"}, {"t0": 11.0, "t1": 14.4, "text": "淚下淚那天 已經不願"}, {"t0": 14.4, "t1": 17.4, "text": "老屁股 老鼠 傻傻笨笨清楚"}, {"t0": 17.4, "t1": 19.4, "text": "對話 難免你吐"}, {"t0": 19.4, "t1": 21.4, "text": "失敗的餵父母"}, {"t0": 21.4, "t1": 24.4, "text": "傻丫頭吐 像愛著別爬褲"}, {"t0": 24.4, "t1": 26.4, "text": "對話 懷怒 清楚"}, {"t0": 26.4, "t1": 28.4, "text": "卻早晚是最苦苦的"}, {"t0": 28.4, "t1": 30.4, "text": "你仍不悔 怪怪"}]