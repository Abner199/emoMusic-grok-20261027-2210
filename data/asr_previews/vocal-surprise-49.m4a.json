[{"t0": 0.0, "t1": 2.0, "text": "绝对才能踏出苍蕴摇头"}, {"t0": 2.0, "t1": 5.0, "text": "小声紧紧握帆"}, {"t0": 5.0, "t1": 8.0, "text": "把你撕的汗"}, {"t0": 8.0, "t1": 11.0, "text": "轻护空下的夜晚"}, {"t0": 11.0, "t1": 14.0, "text": "交变反顾点燃"}, {"t0": 14.0, "t1": 16.0, "text": "梦里的态度"}, {"t0": 16.0, "t1": 20.0, "text": "在半个角上拉开"}, {"t0": 20.0, "t1": 23.0, "text": "这世上的热闹"}, {"t0": 23.0, "t1": 26.0, "text": "数字孤单"}]