[{"t0": 0.0, "t1": 4.0, "text": "再多一笔的家乡"}, {"t0": 4.0, "t1": 6.0, "text": "我不知道个是变成了"}, {"t0": 6.0, "t1": 10.0, "text": "社会的那边"}, {"t0": 10.0, "t1": 11.0, "text": "别扣在拍摩那边"}, {"t0": 11.0, "t1": 13.0, "text": "总得要打起模样"}, {"t0": 13.0, "t1": 14.0, "text": "怎样"}, {"t0": 14.0, "t1": 15.0, "text": "我唱的歌词"}, {"t0": 15.0, "t1": 16.0, "text": "要有点文化"}, {"t0": 16.0, "t1": 19.0, "text": "因为随时会被当脚踩"}, {"t0": 19.0, "t1": 20.0, "text": "say yeah"}, {"t0": 20.0, "t1": 21.0, "text": "能不能等于"}, {"t0": 21.0, "t1": 22.0, "text": "往好一点采访"}, {"t0": 22.0, "t1": 23.0, "text": "是带着这封面"}, {"t0": 23.0, "t1": 25.0, "text": "能不能重拍"}, {"t0": 25.0, "t1": 27.0, "text": "随时随地注意欣赏"}, {"t0": 27.0, "t1": 28.0, "text": "遥控着意识"}, {"t0": 28.0, "t1": 29.0, "text": "不能就肯度下"}, {"t0": 29.0, "t1": 30.0, "text": "詞曲 李宗盛"}]