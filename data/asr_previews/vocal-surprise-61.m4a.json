[{"t0": 0.0, "t1": 3.76, "text": "にさせる 誰もが 目を奪われてく"}, {"t0": 3.76, "t1": 6.96, "text": "君は完璧って 究極のアイバン"}, {"t0": 6.96, "t1": 9.56, "text": "この理財 現れない"}, {"t0": 9.56, "t1": 12.44, "text": "一番ポッシュの マレーカー割り"}, {"t0": 12.44, "t1": 16.04, "text": "ああ その笑顔で 愛してるって"}, {"t0": 16.04, "t1": 19.08, "text": "誰もふかれも 取りこにしていく"}, {"t0": 19.08, "t1": 22.16, "text": "その瞳が その言葉が嘘でも"}, {"t0": 22.16, "t1": 24.76, "text": "それは完全な愛"}, {"t0": 24.76, "t1": 27.64, "text": "はいはい あの子は特別です"}, {"t0": 27.64, "t1": 29.96, "text": "我々は花からおまけです"}]