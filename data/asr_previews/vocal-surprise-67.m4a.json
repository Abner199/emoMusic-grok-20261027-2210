[{"t0": 0.0, "t1": 3.2, "text": "我睜開眼 眼淚滴滴眠"}, {"t0": 3.2, "t1": 5.8, "text": "忍住城區自動染一遍"}, {"t0": 5.8, "t1": 9.2, "text": "我屬於你 沒有期限"}, {"t0": 9.2, "t1": 11.6, "text": "所有你說的不潔明明"}, {"t0": 11.6, "t1": 15.0, "text": "絕對窒息 重新成都低迷"}, {"t0": 15.0, "t1": 19.0, "text": "我的功能就是保護你 向天祖敵"}, {"t0": 19.0, "t1": 23.6, "text": "如影隨心不離 年好把酒氣無期"}, {"t0": 23.6, "t1": 26.6, "text": "從這一刻就是你給我的姓名"}, {"t0": 26.6, "t1": 29.62, "text": "迷茫人类的记忆"}]