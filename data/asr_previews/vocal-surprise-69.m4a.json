[{"t0": 0.0, "t1": 2.0, "text": "非凡我许过来见"}, {"t0": 2.0, "t1": 4.0, "text": "要我学过你是太阳"}, {"t0": 4.0, "t1": 6.0, "text": "以为你说太冷"}, {"t0": 6.0, "t1": 7.0, "text": "人们都像你"}, {"t0": 7.0, "t1": 9.0, "text": "我在自己动画身间"}, {"t0": 9.0, "t1": 10.0, "text": "你说不是"}, {"t0": 10.0, "t1": 12.0, "text": "我怎么叫公主"}, {"t0": 12.0, "t1": 13.0, "text": "看来这位公主"}, {"t0": 13.0, "t1": 15.0, "text": "为人好像不幸"}, {"t0": 15.0, "t1": 17.0, "text": "你不得说"}, {"t0": 17.0, "t1": 20.0, "text": "我被断你"}, {"t0": 20.0, "t1": 24.0, "text": "我说在哪里"}, {"t0": 24.0, "t1": 28.0, "text": "你说在梦里"}, {"t0": 28.0, "t1": 29.0, "text": "说以前别爱你"}, {"t0": 29.0, "t1": 30.0, "text": "我愛你"}]