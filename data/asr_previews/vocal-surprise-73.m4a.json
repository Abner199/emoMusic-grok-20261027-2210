[{"t0": 0.0, "t1": 5.24, "text": "梦里想你装傻 怎么办"}, {"t0": 5.24, "t1": 9.08, "text": "直到我要什么 my god"}, {"t0": 9.08, "t1": 13.92, "text": "如果爱像微风 和你一起追过"}, {"t0": 13.92, "t1": 18.4, "text": "连空间 味道都变成甜的"}, {"t0": 18.4, "t1": 23.6, "text": "当我在发觉 就是爱 世界变了"}, {"t0": 23.6, "t1": 28.68, "text": "当你在装扑 你爱我 手牵着我"}, {"t0": 28.68, "t1": 30.0, "text": "让我真想"}]