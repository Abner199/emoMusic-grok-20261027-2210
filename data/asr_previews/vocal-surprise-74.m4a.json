[{"t0": 0.0, "t1": 6.0, "text": "你又在哭泣 我給不了安慰"}, {"t0": 6.0, "t1": 10.0, "text": "我又在搖頭 有那麼點後悔"}, {"t0": 10.0, "t1": 14.0, "text": "愛情的發展 你難以回頭"}, {"t0": 14.0, "t1": 19.0, "text": "卻無法往前走"}, {"t0": 19.0, "t1": 23.0, "text": "當生不由己出現在胸口"}, {"t0": 23.0, "t1": 28.0, "text": "難可信的塞幾個吻合"}, {"t0": 28.0, "t1": 30.0, "text": "And how I run"}]